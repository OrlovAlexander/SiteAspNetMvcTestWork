@using Locko.ELMA.Credit.Managers
@using ViewType = EleWise.ELMA.Model.Views.ViewType

@inherits ViewItemControl<PropertyViewItem, object, ILocko_LegalSeller>

@{
    var seller = Model != null && Model.AuthorizedSeller != null
        ? Model.AuthorizedSeller
        : InterfaceActivator.Create<ILocko_AuthorizedSeller>();
    var participant = seller.TransactionParticipant != null
        ? seller.TransactionParticipant
        : Locko_TransactionParticipantManager.Instance.Create();

    var part1 = Part1();
    var sellerPanel = SellerPanel();
    var part2 = Part2();

    var savedPrefix = ViewData.TemplateInfo.HtmlFieldPrefix;
    ViewData.TemplateInfo.HtmlFieldPrefix = ViewData.TemplateInfo.GetFullHtmlFieldName("AuthorizedSeller");
    var rootPanelId = string.Format(
        "panel_{0}",
        ViewData.TemplateInfo.GetFullHtmlFieldId("585eb888_18b9_4a39_b7b3_f45856293dd1"));
    ViewData.TemplateInfo.HtmlFieldPrefix = savedPrefix;
}

<div class="collapsible-container panel-content-no-header">
    <div id="@rootPanelId" class="panel-content ">
        @{
            Render(part1, participant, "AuthorizedSeller.TransactionParticipant");
            Render(sellerPanel, seller, "AuthorizedSeller");
            Render(part2, participant, "AuthorizedSeller.TransactionParticipant");
        }
    </div>
</div>

@functions {
    private void Render(RootViewItem item, object model, string relativePrefix)
    {
        var template = ViewData.TemplateInfo;
        var oldPrefix = template.HtmlFieldPrefix;
        var oldModel = ViewData.Model;
        try
        {
            template.HtmlFieldPrefix = template.GetFullHtmlFieldName(relativePrefix);
            ViewData.Model = model;
            using (var data = new ObjectViewData(this, model))
            {
                var viewType = ViewItemControl<PropertyViewItem, object, ILocko_LegalSeller>.ViewType;
                data.ViewType = viewType;
                data.ReadOnly = viewType == EleWise.ELMA.Model.Views.ViewType.Display;
                Write(Html.ViewItem(item));
            }
        }
        finally
        {
            template.HtmlFieldPrefix = oldPrefix;
            ViewData.Model = oldModel;
        }
    }

    private static void AddItems(RootViewItem parent, ViewItem[] items)
    {
        if (items == null)
        {
            return;
        }

        foreach (var item in items)
        {
            if (item != null)
            {
                parent.Items.Add(item);
            }
        }
    }

    private static PanelViewItem PanelItem(string uid, string caption, PanelViewItemStyle style, bool collapsible, string customViewName, bool showEmpty, params ViewItem[] items)
    {
        var panel = new PanelViewItem
        {
            Uid = new Guid(uid),
            Caption = caption ?? string.Empty,
            Style = style,
            Collapsible = collapsible
        };
        if (showEmpty)
        {
            panel.HideEmptySettings = HideEmptyEnum.ShowEmpty;
        }
        if (!string.IsNullOrEmpty(customViewName))
        {
            panel.CustomViewName = customViewName;
        }
        AddItems(panel, items);
        return panel;
    }

    private static ColumnsLayoutViewItem Columns(string uid, bool showEmpty, params ViewItem[] items)
    {
        var layout = new ColumnsLayoutViewItem
        {
            Uid = new Guid(uid)
        };
        if (showEmpty)
        {
            layout.HideEmptySettings = HideEmptyEnum.ShowEmpty;
        }
        AddItems(layout, items);
        return layout;
    }

    private static ColumnViewItem Column(string uid, bool showEmpty, params ViewItem[] items)
    {
        var column = new ColumnViewItem
        {
            Uid = new Guid(uid)
        };
        if (showEmpty)
        {
            column.HideEmptySettings = HideEmptyEnum.ShowEmpty;
        }
        AddItems(column, items);
        return column;
    }

    private static PropertyViewItem PropertyItem(string viewUid, string propertyUid, bool required = false, string caption = null, string customViewName = null)
    {
        var item = new PropertyViewItem
        {
            Uid = new Guid(viewUid),
            PropertyUid = new Guid(propertyUid)
        };
        if (required)
        {
            item.Attributes.Required = true;
        }
        if (!string.IsNullOrEmpty(caption))
        {
            item.Attributes.Name = caption;
        }
        if (!string.IsNullOrEmpty(customViewName))
        {
            item.CustomViewName = customViewName;
        }
        return item;
    }

    private static PropertyValueViewItem PropertyValueItem(string viewUid, string propertyUid, string customViewName)
    {
        return new PropertyValueViewItem
        {
            Uid = new Guid(viewUid),
            PropertyUid = new Guid(propertyUid),
            CustomViewName = customViewName
        };
    }


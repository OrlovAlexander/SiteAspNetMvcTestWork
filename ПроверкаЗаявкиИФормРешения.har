            "mimeType": "application/javascript",
            "compression": 0,
            "text": "elma.SubTaskActions = Object()\r\n\r\nelma.SubTaskActions.CheckActiveSubTasks = function (taskId, onSuccessCallback, callbackParams, customMsg) {\r\n    $.ajax({\r\n        cache: false,\r\n        type: 'GET',\r\n        dataType: 'json',\r\n        url: '/Tasks/Task/HasActiveSubTasks?taskId=' + taskId,\r\n        success: function (data) {\r\n            if (data) {\r\n                if (data.activeSubTasks) {\r\n                    var msg = customMsg || SR.T('В задаче имеются невыполненные подзадачи.<br />В случае продолжения данного действия они останутся активными.<br /><br />Продолжить выполнение данного действия?');\r\n                    jConfirm(msg, SR.T('Предупреждение'), function (r) {\r\n                        if (r) {\r\n                            onSuccessCallback.apply(this, callbackParams);\r\n                        }\r\n                    });\r\n                } else {\r\n                    onSuccessCallback.apply(this, callbackParams);\r\n                }\r\n            }\r\n        },\r\n        error: function (data) {\r\n            elma.closePleaseWait(true);\r\n            jAlert(SR.T('Ошибка сервера'));\r\n        }\r\n    });\r\n}\r\n"
          },
          "redirectURL": "",

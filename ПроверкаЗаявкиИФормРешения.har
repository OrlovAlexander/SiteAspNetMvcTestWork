.text(), true);\r\n        });\r\n\r\n\r\n        selector.onAddItem(function(evt, item) {\r\n            if(evt.isImmediatePropagationStopped() || item.stopEvent) return;\r\n\r\n            var combobox = $('#Entity_Application_FileList_0__FileType_Id').data(\"tComboBox\");\r\n            var previousValue = combobox.previousValue;\r\n\r\n            if (previousValue != item.val) {\r\n\r\n                var s = false;\r\n\r\n                combobox.select(function(data) {\r\n                    return s = data.Value == item.val;\r\n                });\r\n\r\n                if(!s) {\r\n                    combobox.reloadSelect(item.val + '');\r\n                } else {\r\n                    combobox.previousValue = previousValue;\r\n                    combobox.trigger.change();\r\n                }\r\n            }\r\n        });\r\n\r\n        selector.onRemoveItem(function(evt, item) {\r\n\r\n            var node = $('div.Entity_Application_FileList_0__FileType_Id input[value=\"' + item.val + '\"]');\r\n            var id = 'Entity_Application_FileList_0__FileType_Id';\r\n            var comboNameArray = id.split(\"_\");\r\n            var comboNamePrefix = id;\r\n            var comboNameSuffix = \"\";\r\n\r\n            if (comboNameArray.length > 1)\r\n            {\r\n                comboNameSuffix = \".\" + comboNameArray[comboNameArray.length - 1];\r\n                comboNameArray.pop();\r\n                comboNamePrefix = comboNameArray.join('.');\r\n            }\r\n\r\n            onClearItem(node.parent(), comboNamePrefix, comboNameSuffix);\r\n        });\r\n    });\r\n</script>\r\n\r\n<script type=\"text/javascript\">\r\n    $(document).ready(function() {\r\n        var comboboxId = 'Entity_Application_FileList_0__FileType_Id';\r\n        locko.waitUntil(function () {\r\n            var combobox = elma.extractComboBox($(\"#\" + comboboxId));\r\n            if (combobox == null)\r\n            {\r\n                var input = $(\"#\" + combobox
cation_93fc6848_ff99_493a_ad8d_f8e431613776(event);\">\r\n                <span id=\"imgClose_Entity_Application_93fc6848_ff99_493a_ad8d_f8e431613776\" class=\"collapseImage\" style=\"display:inline-block\"></span>\r\n                <span id=\"imgOpen_Entity_Application_93fc6848_ff99_493a_ad8d_f8e431613776\" class=\"expandImage\" style=\"display:none\"></span>\r\n                <span id=\"headerText_Entity_Application_93fc6848_ff99_493a_ad8d_f8e431613776\">\r\n                    Информация об автомобиле\r\n                </span>\r\n            </div>\r\n        </div>\r\n        <div id=\"ajaxPanel_Entity_Application_93fc6848_ff99_493a_ad8d_f8e431613776\" class=\"panel-content\" style=\"\" showScript=\"ShowEntity_Application_93fc6848_ff99_493a_ad8d_f8e431613776()\"\r\n                >\r\n\r\n<div class=\"table-form-container\" style=\"\"><table class=\"table-form table-ColumnItem\" style=\"\"><tr class=\"\" hideCount=\"0\"><td class=\"table-SingleColumnItem\" colspan=\"2\">\r\n\r\n        <div id=\"panel_Entity_Application_9202617d_ec44_4205_b417_a5a732f86663\" class=\"panel-content\"\r\n            >\r\n\r\n<script>\r\n    $(document).ready(function() {\r\n        if (true) {\r\n            $('[id*=\"db8869bb_9122_4271_97dc_49e60365660d\"]').hide();\r\n        }\r\n    })\r\n</script>        </div>\r\n</td></tr></table></div>        </div>\r\n\r\n\r\n        <script type=\"text/javascript\">\r\n            function ClickExpandEntity_Application_26def957_e6af_4ca8_9a1c_ea87f6b83027(e) {\r\n                if (!e) e = window.event;\r\n                if (e) {\r\n                    var tgt = e.target || e.srcElement;\r\n                    if (tgt.nodeName == 'A')\r\n                        return;\r\n                }\r\n                elma.dynamics.statictoggle('ajaxPanel_Entity_Application_26def957_e6af_4ca8_9a1c_ea87f6b83027', 'imgClose_Entity_Application_26def957_e6af_4ca8_9a1c_ea87f6b83027', 'imgOpen_Entity_Application_26def957_e6af_4ca8_9a1c_ea87f6b83027', 'headerText_Entity_Application_26def957_e6af_4ca8_9a1c_ea87f6b83027', 'Параметры кредита', 'Параметры кредита');\r\n            }\r\n            function ShowEntity_Application_26def957_e6af_4ca8_9a1c_ea87f6b83027(){\r\n                if ($('#ajaxPanel_Entity_Application_26def957_e6af_4ca8_9a1c_ea87f6b83027').is(':hidden'))\r\n                    ClickExpandEntity_Application_26def957_e6af_4ca8_9a1c_ea87f6b83027();\r\n            }\r\n        </script>\r\n        <div id=\"Entity_Application_26def957_e6af_4ca8_9a1c_ea87f6b83027\" class=\"collapsible-panel\">\r\n            <div class=\"collapsible-panel-header separator-blue\" onclick=\"ClickExpandEntity_Application_26def957_e6af_4ca8_9a1c_ea87f6b83027(event);\">\r\n                <span id=\"imgClose_Entity_Application_26def957_e6af_4ca8_9a1c_ea87f6b83027\" class=\"collapseImage\" style=\"display:inline-block\"></span>\r\n                <span id=\"imgOpen_Entity_Application_26def957_e6af_4ca8_9a1c_ea87f6b83027\" class=\"expandImage\" style=\"display:none\"></span>\r\n                <span id=\"headerText_Entity_Application_26def957_e6af_4ca8_9a1c_ea87f6b83027\">\r\n                    Параметры кредита\r\n                </span>\r\n            </div>\r\n        </div>\r\n        <div id=\"ajaxPanel_Entity_Application_26def957_e6af_4ca8_9a1c_ea87f6b83027\" class=\"panel-content\" style=\"\" showScript=\"ShowEntity_Application_26def957_e6af_4ca8_9a1c_ea87f6b83027()\"\r\n                >\r\n\r\n<div class=\"table-form-container\" style=\"\"><table class=\"table-form table-ColumnItem\" style=\"\"><tr class=\"\" hideCount=\"0\"><td class=\"table-SingleColumnItem\" colspan=\"2\">\r\n\r\n        <div id=\"panel_Entity_Application_ba364a3e_e260_4622_8713_232e49860b9d\" class=\"panel-content\"\r\n            >\r\n\r\n\r\n\r\n<script>\r\n\r\n\r\n$(document).ready(function () {\r\n\r\n    if (false) {      \r\n        let onlyRefinCheckBox = $('#OnlyRefin');\r\n        if (onlyRefinCheckBox != null) {\r\n            onlyRefinCheckBox.prop('checked', true);\r\n            HandleClickRefin(onlyRefinCheckBox);\r\n            onlyRefinCheckBox.prop('disabled', true);\r\n        }\r\n    }\r\n    else if (false) {\r\n        let onlyRefinCheckBox = $('#OnlyRefin');\r\n        if (onlyRefinCheckBox != null) {\r\n            onlyRefinCheckBox.prop('checked', true);\r\n            HandleClickRefin(onlyRefinCheckBox);\r\n        }\r\n    }\r\n    else {\r\n        CheckFilledOutFields();\r\n    }\r\n\r\n});\r\n\r\n// CRC-3552 - Вывод сообщения, если заполнено одно из полей по Рефину\r\n function CheckFilledOutFields()\r\n {\r\n\r\n    var fields = $(\"[id$='_MaxApprovalLoanAmountRefin'],[id$='_MaxApprovalLoanAmountCollateralRefin'],[id$='_MaxApprovalLoanAmountRealPropertyRefin']\");\r\n    console.log(fields.length);\r\n\r\n    fields.each(function()\r\n     {       \r\n        $(this).bind('change', function()\r\n        {\r\n            CheckRefinFields(fields)\r\n        });\r\n    });\r\n\r\n    CheckRefinFields(fields);\r\n}; \r\n\r\nfunction CheckRefinFields(fields)\r\n{\r\n    // RPC-882 - Возможность ограничения суммы кредита на стороне АН при рефинансировании\r\n    if (false) {\r\n        return;\r\n    }\r\n    \r\n    var check = false;\r\n    fields.each(function()\r\n      {\r\n        if(true && this.value != null && this.value != '' && parseInt(this.value, 10) != 0)\r\n        {\r\n            console.log('value is' + this.value);\r\n            check = true;\r\n            $('#sendForRefinementMessage').remove();\r\n            var refinementMessage = '<div id=\\\"sendForRefinementMessage\\\" style=\\\"color: red\\\">Отправьте заявку на доработку анкеты</div>';   \r\n            $(this).parent().parent().after(refinementMessage);         \r\n        }\r\n\r\n     });\r\n\r\n     if (!check)\r\n     {\r\n        $('#sendForRefinementMessage').remove();\r\n     }\r\n}\r\n\r\n</script>\r\n\r\n<table width=\"100%\">\r\n    <tr>\r\n        <td>\r\n<div class=\"table-form-container\" style=\"\"><table class=\"show-lines table-form\" style=\"\">            <td class=\"captionCell\">Учитываемый доход\r\n</td>\r\n            <td>\r\n                <div id=\"Locko_Application_RecordedIncome\">950&#160;000,00</div>\r\n            </td>\r\n</table></div>        </td>\r\n        <td>\r\n<div class=\"table-form-container\" style=\"\"><table class=\"show-lines table-form\" style=\"\">                <td class=\"captionCell\">Учитываемый расход\r\n</td>\r\n                <td>\r\n                    <div id=\"Locko_Application_RecordedExpenditure\">28&#160;635,00</div>\r\n                </td>\r\n</table></div>       </td>\r\n                    <td>\r\n<div class=\"table-form-container\" style=\"\"><table class=\"show-lines table-form\" style=\"\">                    <td class=\"captionCell\">Первоначальный взнос\r\n</td>\r\n                    <td>\r\n                        <div id=\"Locko_Application_InitialPayment\">12&#160;500&#160;000,00</div>\r\n                    </td>\r\n</table></div>            </td>\r\n    </tr>\r\n</table>\r\n\r\n<div class=\"table-form-container\" style=\"\"><table class=\"table-form\" style=\"\">                <tbody>\r\n                    <tr>\r\n                        <td style=\"width: 50%; vertical-align: top;\">\r\n                            <table width=\"100%\">\r\n                                <tbody>\r\n                                                                            <tr>\r\n                                            <td class=\"dft_table_td_inputs captionCell\" style=\"padding-top: 5px;\">\r\n                                                \t<span class=\"caption-required\">Максимальная одобренная сумма кредита на ипотеку (Андеррайтер)</span>\r\n\r\n\r\n                                            </td>\r\n                                            <td style=\"padding-top: 5px;\">\r\n                                                \r\n\r\n<div class=\"t-widget t-numerictextbox\" style=\"width:150px;\"><input class=\"t-input\" id=\"Entity_Application_MaxApprovalLoanAmountMortgage\" name=\"Entity.Application.MaxApprovalLoanAmountMortgage\" style=\"\" /></div>\r\n<span class=\"field-validation-valid\" id=\"Entity_Application_MaxApprovalLoanAmountMortgage_validationMessage\"></span>\r\n                                            </td>\r\n                                        </tr>\r\n                                                                    </tbody>\r\n                            </table>\r\n                        </td>\r\n                        <td style=\"width: 50%; vertical-align: top;\">\r\n                            <table width=\"100%\">\r\n                                <tbody>\r\n                                </tbody>\r\n                            </table>\r\n                        </td>\r\n                    </tr>\r\n                </tbody>\r\n                <script>\r\n                    function HandleClickPledge(e) {\r\n                        if ($(e).prop('checked')) {\r\n                            if (false) {\r\n                                $('#Entity_Application_MaxApprovalLoanAmount').val('');\r\n                                $('#Entity_Application_MaxApprovalLoanAmount').get(0).parentElement.firstChild.innerText = '';\r\n                                $('#Entity_Application_MaxApprovalLoanAmount').parent().parent().parent().hide();\r\n                                elma.ValidationRulesManager.disible('Entity_Application_MaxApprovalLoanAmount');\r\n\r\n                                if (false) {\r\n                                    $('#Entity_Application_MaxApprovalLoanAmountRefin').val('');\r\n                                    $('#Entity_Application_MaxApprovalLoanAmountRefin').get(0).parentElement.firstChild.innerText = '';\r\n                                    $('#Entity_Application_MaxApprovalLoanAmountRefin').parent().parent().parent().hide();\r\n                                    elma.ValidationRulesManager.disible('Entity_Application_MaxApprovalLoanAmountRefin');\r\n                                }\r\n                            }\r\n                        }\r\n                        else {\r\n                            if (false) {\r\n                                if (false && $('#OnlyRefin').prop('checked')) {\r\n                                    $('#Entity_Application_MaxApprovalLoanAmountRefin').parent().parent().parent().show();\r\n                                    elma.ValidationRulesManager.enable('Entity_Application_MaxApprovalLoanAmountRefin');\r\n                                }\r\n                                else {\r\n                                    $('#Entity_Application_MaxApprovalLoanAmount').parent().parent().parent().show();\r\n                                    elma.ValidationRulesManager.enable('Entity_Application_MaxApprovalLoanAmount');\r\n                                }\r\n                            }\r\n                        }\r\n                    }\r\n\r\n                    function HandleClickRefin(e) {\r\n                        if ($(e).prop('checked')) {\r\n                            if (false) {\r\n                                $('#Entity_Application_MaxApprovalLoanAmountCollateralRefin').parent().parent().parent().show();\r\n                                elma.ValidationRulesManager.addRule('Entity_Application_MaxApprovalLoanAmountCollateralRefin', 'add', {required: true, messages: { required: \"Заполните обязательное поле\"}});\r\n                                $('#Entity_Application_MaxApprovalLoanAmountCollateral').parent().parent().parent().hide();\r\n                                $('#Entity_Application_MaxApprovalLoanAmountCollateral').val('');\r\n                                $('#Entity_Application_MaxApprovalLoanAmountCollateral').get(0).parentElement.firstChild.innerText = '';\r\n                                elma.ValidationRulesManager.disible('Entity_Application_MaxApprova
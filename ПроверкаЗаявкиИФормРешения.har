            "text": "/*\r\n    calendarTable\r\n*/\r\n\r\n.calendar-table {\r\n    background-color: #cbe2ff;\r\n    min-width: 100%;\r\n    color: #000;\r\n    border-collapse: collapse;\r\n    border: 1px solid rgba(255, 255, 255, 0.25);\r\n    text-align: center;\r\n    white-space: nowrap;\r\n}\r\n\r\n.calendar-table caption,\r\n.calendar-table th,\r\n.calendar-table td {\r\n    border: 1px solid #ced2d8;\r\n    padding: 2px;\r\n    height: 20px;\r\n    line-height: 20px;\r\n}\r\n\r\n.calendar-table caption {\r\n    background-color: #cbe2ff;\r\n    height: 40px;\r\n    position: relative;\r\n}\r\n\r\n.calendar-table caption .caption-name {\r\n    text-transform: uppercase;\r\n}\r\n\r\n.calendar-table caption .caption-button-left,\r\n.calendar-table caption .caption-button-right {\r\n    width: 44px;\r\n    height: 44px;\r\n    position: absolute;\r\n    left: 0;\r\n    right: auto;\r\n    top: 0;\r\n    background-color: #cbe2ff;\r\n    cursor: pointer;\r\n}\r\n\r\n.calendar-table caption .caption-button-left img,\r\n.calendar-table caption .caption-button-right img {\r\n    margin: 6px;\r\n}\r\n\r\n.calendar-table caption .caption-button-right {\r\n    left: auto;\r\n    right: 0;\r\n    background-color: #cbe2ff;\r\n}\r\n\r\n.calendar-table caption .caption-button-left:hover,\r\n.calendar-table caption .caption-button-right:hover {\r\n    background-color: #b9d8ff;\r\n}\r\n\r\n.calendar-table .meeting-cell {\r\n    background-color: #d4f1d7;\r\n    position: relative;\r\n    cursor: default;\r\n}\r\n\r\n.calendar-table .meeting-cell.capacity-cell {\r\n    background-color: #97f3e1;\r\n}\r\n\r\n.calendar-table .meeting-cell.max-capacity-cell {\r\n    background-color: #ffd4d4;\r\n}\r\n\r\n.calendar-table .meeting-cell.capacity-cell.external-sale {\r\n    background-color: #28675c;\r\n}\r\n\r\n.calendar-table .meeting-cell:hover {\r\n    background-color: #c2eccd;\r\n}\r\n\r\n.calendar-table .meeting-cell.capacity-cell:hover {\r\n    background-color: #8eecda;\r\n}\r\n\r\n.calendar-table .meeting-cell.max-capacity-cell:hover {\r\n    background-color: #ffc4c4;\r\n}\r\n\r\n.calendar-table .meeting-cell.capacity-cell.external-sale:hover {\r\n    background-color: #3b7369;\r\n}\r\n\r\n.calendar-table .meeting-cell-marker {\r\n    display: block;\r\n    content: \"\";\r\n    position: absolute;\r\n    left: 0;\r\n    top: 0;\r\n    border: 15px solid transparent;\r\n    border-left: 15px solid #f58025;\r\n    border-top-width: 0;\r\n    border-right-width: 0;\r\n}\r\n\r\n.calendar-table .meeting-cell .branch-badge,\r\n.calendar-table .meeting-cell .bank-badge {\r\n    font-weight: bold;\r\n    display: inline-block;\r\n    padding: 3px 9px;\r\n    border: 1px solid #c2eccd;\r\n    font-size: 12px;\r\n    line-height: 1;\r\n    text-align: center;\r\n    white-space: nowrap;\r\n    vertical-align: baseline;\r\n    -moz-border-radius: 5px;\r\n    -webkit-border-radius: 5px;\r\n    border-radius: 5px;\r\n    color: #4c4c4c;\r\n    position: relative;\r\n    -moz-transition: all 0.3s;\r\n    -o-transition: all 0.3s;\r\n    -webkit-transition: all 0.3s;\r\n    transition: all 0.3s;\r\n}\r\n\r\n.calendar-table .meeting-cell.external-sale .branch-badge,\r\n.calendar-table .meeting-cell.external-sale .bank-badge {\r\n    color: #fff;\r\n}\r\n\r\n.calendar-table .meeting-cell.capacity-cell .branch-badge,\r\n.calendar-table .meeting-cell.capacity-cell .bank-badge {\r\n    border-color: #b9d8ff;\r\n}\r\n\r\n.calendar-table .meeting-cell.max-capacity-cell .branch-badge,\r\n.calendar-table .meeting-cell.max-capacity-cell .bank-badge {\r\n    border-color: #ffc4c4;\r\n}\r\n\r\n.calendar-table .meeting-cell .bank-badge .badge-inner {\r\n    position: absolute;\r\n    left: 0;\r\n    right: 0;\r\n    top: 0;\r\n    bottom: 0;\r\n    margin: auto;\r\n    opacity: 0;\r\n    -moz-transition: all 0.3s;\r\n    -o-transition: all 0.3s;\r\n    -webkit-transition: all 0.3s;\r\n    transition: all 0.3s;\r\n    cursor: pointer;\r\n    background-position: center;\r\n    background-repeat: no-repeat;\r\n}\r\n\r\n.calendar-table .meeting-cell .bank-badge:hover {\r\n    color: transparent;\r\n}\r\n\r\n.calendar-table .meeting-cell .bank-badge:hover .badge-inner {\r\n    opacity: 1;\r\n}\r\n\r\n/*\r\n    calendarPopupTable\r\n*/\r\n\r\n.calendar-popup-table {\r\n    background-color: #cbe2ff;\r\n    min-width: 100%;\r\n    color: #000;\r\n    border-collapse: collapse;\r\n    border: 1px solid rgba(255, 255, 255, 0.25);\r\n    white-space: nowrap;\r\n}\r\n\r\n.calendar-popup-table caption,\r\n.calendar-popup-table th,\r\n.calendar-popup-table td {\r\n    border: 1px solid #ced2d8;\r\n    padding: 2px 6px;\r\n    height: 20px;\r\n    line-height: 20px;\r\n    text-align: left;\r\n}\r\n\r\n.calendar-popup-table caption {\r\n    text-align: center;\r\n    background-color: #cbe2ff;\r\n    height: 40px;\r\n}\r\n\r\n.calendar-popup-table caption .caption-name {\r\n    text-transform: uppercase;\r\n}\r\n\r\n.calendar-popup-table tr.item-row td {\r\n    background-color: #fdfdfd;\r\n}\r\n\r\n.calendar-popup-table tr.item-row:hover td {\r\n    background-color: #f0f0f0;\r\n}\r\n\r\n.calendar-popup-table tr.item-row.external-sale td {\r\n    background-color: #28675c;\r\n    color: #fff;\r\n}\r\n\r\n.calendar-popup-table tr.item-row.external-sale:hover td {\r\n    background-color: #3b7369;\r\n    color: #fff;\r\n}\r\n\r\n.calendar-popup-table tr.empty-row td {\r\n    background-color: #ffd4d4;\r\n    text-align: center;\r\n}\r\n\r\n.calendar-popup-table tr.empty-row:hover td {\r\n    background-color: #ffc4c4;\r\n}\r\n\r\n.calendar-popup-table tr.item-row.hidden {\r\n    display: none;\r\n}\r\n\r\n#Locko_CalendarPopup {\r\n    width: 100% !important;\r\n}\r\n#Locko_CalendarPopup .t-content {\r\n    width: calc(100% - 2px) !important;\r\n    overflow: auto !important;\r\n}"

          "content": {
            "size": 2934,
            "mimeType": "application/javascript",
            "compression": 0,
            "text": "function Locko_SetNotificationsPopup(id) {\r\n    var $popupBox = $('#' + id + ' .notifications-popup-resizeble');\r\n    var $mainButton = $('#' + id + ' .notifications-popup-button');\r\n    var $moveButton = $('#' + id + ' .notifications-popup-move-button');\r\n    var $closeButton = $('#' + id + ' .notifications-popup-close-button');\r\n\r\n    $mainButton.click(function () {\r\n        if (!$('#' + id).hasClass('opened')) {\r\n            $popupBox.show();\r\n            $closeButton.show();\r\n            $mainButton.hide();\r\n            $('#' + id).addClass('opened');\r\n            Locko_MoveNotificationsPopupBoxToLeft(id);\r\n            Locko_CheckNotificationsPopupOffset(id);\r\n        }\r\n    });\r\n    $closeButton.click(function () {\r\n        if ($('#' + id).hasClass('opened')) {\r\n            $popupBox.hide();\r\n            $closeButton.hide();\r\n            $mainButton.show();\r\n            $('#' + id).removeClass('opened');\r\n            Locko_MoveNotificationsPopupMainButtonToRight(id);\r\n            Locko_CheckNotificationsPopupOffset(id);\r\n        }\r\n    });\r\n\r\n    $('#' + id).draggable({\r\n        handle: $moveButton,\r\n        stop: function (e, ui) {\r\n            Locko_CheckNotificationsPopupOffset(id);\r\n        }\r\n    });\r\n\r\n    $popupBox.resizable({\r\n        resize: function (event, ui) {\r\n            Locko_CheckNotificationsPopupOffset(id);\r\n        }\r\n    });\r\n}\r\n\r\nfunction Locko_MoveNotificationsPopupBoxToLeft(id) {\r\n    var $popupMain = $('#' + id);\r\n    var $popupBox = $('#' + id + ' .notifications-popup-resizeble');\r\n    var $mainButton = $('#' + id + ' .notifications-popup-button');\r\n\r\n    $popupMain.css('left', ($popupMain.offset().left - $popupBox.outerWidth() + $mainButton.outerWidth()).toString() + 'px');\r\n}\r\n\r\nfunction Locko_MoveNotificationsPopupMainButtonToRight(id) {\r\n    var $popupMain = $('#' + id);\r\n    var $popupBox = $('#' + id + ' .notifications-popup-resizeble');\r\n    var $mainButton = $('#' + id + ' .notifications-popup-button');\r\n\r\n    $popupMain.css('left', ($popupMain.offset().left + $popupBox.outerWidth() - $mainButton.outerWidth()).toString() + 'px');\r\n}\r\n\r\nfunction Locko_CheckNotificationsPopupOffset(id) {\r\n    var $popupMain = $('#' + id);\r\n\r\n    var popupWidth = $popupMain.outerWidth();\r\n    var popupHeight = $popupMain.outerHeight();\r\n    var popupOffsetTop = $popupMain[0].offsetTop;\r\n    var popupOffsetLeft = $popupMain[0].offsetLeft;\r\n\r\n    var windowWidth = $(window).width();\r\n    var windowHeight = $(window).height();\r\n\r\n    if (popupOffsetTop + popupHeight > windowHeight) {\r\n        $popupMain.css('top', (windowHeight - popupHeight).toString() + 'px');\r\n    }\r\n    if (popupOffsetLeft + popupWidth > windowWidth) {\r\n        $popupMain.css('left', (windowWidth - popupWidth).toString() + 'px');\r\n    }\r\n    if (popupOffsetTop < 0) {\r\n        $popupMain.css('top', '0px');\r\n    }\r\n    if (popupOffsetLeft < 0) {\r\n        $popupMain.css('left', '0px');\r\n    }\r\n}"
          },

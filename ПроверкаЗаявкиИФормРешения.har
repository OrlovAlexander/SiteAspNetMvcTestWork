          "content": {
            "size": 6189,
            "mimeType": "application/javascript",
            "compression": 0,
            "text": "if (window.locko == null)\r\n    locko = {};\r\n\r\nlocko.pdf = function () {\r\n    var fileList = [];\r\n    var buttons = [];\r\n\r\n    var buttonDisibled = function (value) {\r\n        $.each(buttons, function (index, button) {\r\n            $(button).prop(\"disabled\", value);\r\n        });\r\n    };\r\n\r\n    return {\r\n        register: function (button, uid, inputId, providerUid, providerData, providerDataClientScript, url) {\r\n            if (button.pdfFiles == null) {\r\n                button.pdfFiles = [];\r\n            }\r\n\r\n            button.url = url;\r\n\r\n            var exists = false;\r\n        \t$.each(buttons, function (index, b) {\r\n            \tif (b == button) {\r\n                \texists = true;\r\n            \t}\r\n        \t});\r\n        \tif (!exists) {\r\n            \tbuttons.push(button);\r\n        \t}\r\n\r\n            if (uid == null || uid.length == 0)\r\n                return;\r\n\r\n            exists = false;\r\n            $.each(fileList, function (index, f) {\r\n                if (f.uid == uid)\r\n                {\r\n                    exists = true;\r\n                }\r\n            });\r\n            if (!exists)\r\n            {\r\n                fileList.push({ uid: uid, inputId: inputId, providerUid: providerUid, providerData: providerData, providerDataClientScript: providerDataClientScript });\r\n            }\r\n\r\n            exists = false;\r\n            $.each(button.pdfFiles, function (index, f) {\r\n                if (f == uid) {\r\n                    exists = true;\r\n                }\r\n            });\r\n            if (!exists) {\r\n                button.pdfFiles.push(uid);\r\n            }\r\n        },\r\n        generate: function (button) {\r\n            var files = button.pdfFiles;\r\n            if (files == null || files.length == 0) {\r\n                files = [];\r\n                $.each(fileList, function (index, f) {\r\n                    if ((!f.providerUid || f.providerUid == \"00000000-0000-0000-0000-000000000000\") && f.uid) {\r\n                        files.push(f.uid);\r\n                    }\r\n                });\r\n            }\r\n\r\n            var postData = [];\r\n            var formData;\r\n\r\n            var error = false;\r\n\r\n            $.each(files, function (index, file) {\r\n                if (error) return;\r\n                $.each(fileList, function (idx, f) {\r\n                    var prefix = \"attachments[\" + index + \"]\";\r\n                    if (error) return;\r\n                    if (f.uid == file) {\r\n                        if (f.providerDataClientScript != null && f.providerDataClientScript != \"\") {\r\n                            var d = window[f.providerDataClientScript](prefix);\r\n                            if (d == null)\r\n                            {\r\n                                error = true;\r\n                                return;\r\n                            }\r\n                            if (Array.isArray(d))\r\n                            {\r\n                                $.each(d, function (i, d1) {\r\n                                    postData[d1.name] = d1.value;\r\n                                });\r\n                            }\r\n                            else\r\n                            {\r\n                                formData = $.extend({}, d);\r\n                            }\r\n                        }\r\n                        postData[prefix + \".Id\"] = f.uid;\r\n                        postData[prefix + \".Copies\"] = !!f.inputId && $(\"#\" + f.inputId).val() ? $(\"#\" + f.inputId).val() : 1;\r\n                        postData[prefix + \".ProviderUid\"] = f.providerUid;\r\n                        postData[prefix + \".ProviderData\"] = f.providerData;\r\n                    }\r\n                });\r\n            });\r\n\r\n            if (error) return;\r\n\r\n            var span = $(\"#span_\" + button.id);\r\n            var spanText = span.find(\"span:first\");\r\n\r\n            var writeText = function (value) {\r\n                spanText.text(SR.T(\"Генерация файла PDF... \") + value + \"%\");\r\n            };\r\n\r\n            buttonDisibled(true);\r\n            writeText(0);\r\n            span.show();\r\n\r\n            var stateUid;\r\n            var statePdfLoad = function () {\r\n                $.ajax({\r\n                    cache: false,\r\n                    type: \"POST\",\r\n                    data: { stateUid: stateUid },\r\n                    url: window.BaseUrl + 'Locko.ELMA.Common.Web/PdfCreater/GetState',\r\n                    success: function (data) {\r\n                        var procent = data.state.Completed > 0 ? Math.round(100 / data.state.Count * data.state.Completed) : (data.isComplete ? 100 : 0);\r\n                        writeText(procent);\r\n\r\n                        if (!data.isComplete) {\r\n                            window.setTimeout(statePdfLoad, 500);\r\n                            return;\r\n                        }\r\n\r\n                        window.setTimeout(function () {\r\n                            span.hide();\r\n                            buttonDisibled(false);\r\n                        }, 100);\r\n\r\n                        if (data.state.ErrorMessage == null || data.state.ErrorMessage == \"\")\r\n                        {\r\n                            location.href = '/SDK.Action/BinaryFiles/Download/' + data.state.FileGuid;\r\n                        }\r\n                        else\r\n                        {\r\n                            jAlert(data.state.ErrorMessage, SR.T(\"Ошибка\"));\r\n                        }\r\n                        \r\n\r\n                        $.ajax({\r\n                            cache: false,\r\n                            type: \"GET\",\r\n                            data: { stateUid: stateUid },\r\n                            url: window.BaseUrl + 'Locko.ELMA.Common.Web/PdfCreater/RemoveState'\r\n                        });\r\n                    }\r\n                });\r\n            };\r\n\r\n            $.ajax({\r\n                cache: false,\r\n                type: \"POST\",\r\n                data: $.extend({}, postData, formData),\r\n                url: button.url,\r\n                success: function (data) {\r\n                    stateUid = data.stateUid;\r\n                    window.setTimeout(statePdfLoad, 100);\r\n                }\r\n            });\r\n        }\r\n    };\r\n}();\r\n"

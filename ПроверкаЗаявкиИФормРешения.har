          "content": {
            "size": 5751,
            "mimeType": "application/javascript",
            "compression": 0,
            "text": "function Locko_ApplicationPortlet_ButtonTakeToWorkPing(gridId, reCall) {\r\n    var button = $(\"#Application_ToWork_Button_\" + gridId);\r\n    var div = $(\"#Application_ToWork_Div_\" + gridId);\r\n\r\n    var isUpdate = button.attr(\"isUpdate\");\r\n    if (isUpdate != null && isUpdate != \"\")\r\n        return;\r\n    button.attr(\"isUpdate\", \"true\");\r\n\r\n    $.ajax({\r\n        url: '/Locko.ELMA.Credit.Web/Application/TasksCountForUNCA',\r\n        type: \"POST\",\r\n        data: null,\r\n        cache: false,\r\n        success: function (data) {\r\n            if (typeof data !== 'undefined' && data != null && typeof data.count !== 'undefined' && data.count != undefined && data.count != null) {\r\n                button.val(button.val().replace(/\\((.*)\\)/, '(' + data.count + ')'));\r\n                var isChange = button.is(\":hidden\") == (data.count > 0);\r\n                if (isChange) {\r\n                    if (data.count > 0) {\r\n                        button.show();\r\n                        div.hide();\r\n                    }\r\n                    else {\r\n                        button.hide();\r\n                        div.show();\r\n                    }\r\n                    refreshGrid(gridId, function () { });\r\n                }\r\n            }\r\n            if (reCall) {\r\n                window.setTimeout(function () { Locko_ApplicationPortlet_ButtonTakeToWorkPing(gridId, reCall); }, 30000);\r\n            }\r\n            button.removeAttr(\"isUpdate\");\r\n        }\r\n    });\r\n}\r\n\r\nfunction Locko_ApplicationPortlet_Filter(gridId, button, fieldId, userId) {\r\n    var filterAction = $(button).attr(\"filterAction\");\r\n    if (!$(button).hasClass(\"current-watch\")) {\r\n        Locko_ApplicationPortlet_Filter_ReloadExecutorFields(filterAction, fieldId, userId);\r\n    }\r\n    $(\"#div_\" + gridId).find(\".current-watch\").removeClass(\"current-watch\");\r\n    $(button).addClass(\"current-watch\");\r\n\r\n    refreshGrid(gridId, function () { }, { filterAction: filterAction });\r\n}\r\n\r\nfunction Locko_ApplicationPortlet_Filter_ReloadExecutorFields(filterAction, fieldId, userId) {\r\n    var executorsSelector = elma.EntitySelector.Manager.get(fieldId + \"_Executors_Id\");\r\n    executorsSelector.clearSelected();\r\n\r\n    if (filterAction === \"OnlyMy\") {\r\n        $('#' + fieldId + '_SystemUserTask_Container input[name$=\".SystemUserTask\"]').prop('checked', false);\r\n        executorsSelector.addItem(userId);\r\n    }\r\n    if (filterAction === \"InQueue\") {\r\n        $('#' + fieldId + '_SystemUserTask_yes').prop('checked', true);\r\n    }\r\n    if (filterAction === \"InWork\") {\r\n        $('#' + fieldId + '_SystemUserTask_no').prop('checked', true);\r\n    }\r\n    if (filterAction === \"All\") {\r\n        $('#' + fieldId + '_SystemUserTask_Container input[name$=\".SystemUserTask\"]').prop('checked', false);\r\n    }\r\n}\r\n\r\nfunction Locko_ApplicationPortlet_ToWork(gridId, taskId, redirectUrl, userId) {\r\n    var postData = [];\r\n    if (userId != null) {\r\n        postData['userId'] = userId;\r\n    }\r\n    if (taskId != null) {\r\n        postData['taskId'] = taskId;\r\n    }\r\n    postData['reassignApproved'] = false;\r\n    var actionUrl = '/Locko.ELMA.Credit.Web/Application/ReassignTaskWithApprove'\r\n    elma.openPleaseWait(true);\r\n    $.ajax({\r\n        url: actionUrl,\r\n        type: \"POST\",\r\n        data: $.extend({}, postData),\r\n        cache: false,\r\n        success: function (data) {\r\n            elma.closePleaseWait(true);\r\n            if (!data.success) {\r\n                if (data.header) {\r\n                    refreshPopup(\"SomebodyWorkingWithTaskPopup\", '/Locko.ELMA.Credit.Web/Application/ReassignTaskWithApprovePopup?taskId=' + taskId + '&userId=' + userId + '&reassignApproved=' + 'false' + '&bodyMessage=' + data.error + '&redirectUrl=' + redirectUrl + '&gridId=' + gridId, null, data.header);\r\n                }\r\n                else {\r\n                    jAlert(SR.T(\"Невозможно выполнить операцию.\") + \"<br>\" + data.error, SR.T(\"Ошибка\"), function () { refreshGrid(gridId, function () { }); });\r\n                }\r\n            }\r\n            else {\r\n                if (redirectUrl != null && redirectUrl != \"\") {\r\n                    document.location.href = redirectUrl;\r\n                }\r\n                else {\r\n                    refreshGrid(gridId, function () { Locko_ApplicationPortlet_ButtonTakeToWorkPing(gridId); });\r\n                }\r\n            }\r\n        }\r\n    });\r\n}\r\n\r\nfunction Locko_ApplicationPortlet_Reassign(gridId, taskId) {\r\n    var popupId = \"ExecutorSelectPopup\";\r\n    var url = '/Locko.ELMA.Credit.Web/Application/ExecutorSelectPopup?scriptSelect=Locko_ApplicationPortlet_ReassignCallBack'\r\n        + (taskId != null ? '&taskId=' + taskId : \"\")\r\n        + '&popupId=' + popupId\r\n        + '&scriptParam=' + gridId + ',' + taskId;\r\n    refreshPopup(popupId, url, null, SR.T(\"Назначить исполнителя\"));\r\n}\r\n\r\nfunction Locko_ApplicationPortlet_ReassignCallBack(parameters) {\r\n    var userId = parameters.UserId;\r\n    var params = parameters.ScriptParam;\r\n    var arrParams = params.split(\",\");\r\n    var gridId = arrParams[0];\r\n    var taskId = arrParams[1];\r\n    Locko_ApplicationPortlet_ToWork(gridId, taskId, null, userId);\r\n}\r\n\r\n$(\".locko_applicationPortletGridRow\").live(\"click\", function (e) {\r\n    var tagName = e.target.tagName.toLowerCase();\r\n    if (tagName == \"a\" || tagName == \"input\")\r\n        return;\r\n\r\n    var row = $(e.target);\r\n\r\n    if (tagName != \"tr\")\r\n        row = row.parents(\"tr:first\");\r\n\r\n    var applicationId = row.attr(\"applicationId\");\r\n    var taskId = row.attr(\"taskId\");\r\n\r\n    document.location.href = window.BaseUrl + 'Locko.ELMA.Credit.Web/Application/RedirectTo?applicationId=' + applicationId + \"&taskId=\" + taskId + \"&backUrl=\" + document.location.href;\r\n});\r\n"
          },

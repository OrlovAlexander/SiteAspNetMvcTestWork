ss=\"t-window-titlebar t-header\">&nbsp;<span class=\"t-window-title\">Трудозатраты</span><div class=\"t-window-actions t-header\"><a class=\"t-window-action t-link\" href=\"\"><span class=\"t-icon t-close\">Close</span></a></div></div><div class=\"t-window-content t-content\" style=\"overflow:hidden\"></div></div>\r\n\r\n\r\n\r\n<div class=\"t-widget t-window\" id=\"DownloadSelectedFilesPopup\" style=\"display:none\"><div class=\"t-window-titlebar t-header\">&nbsp;<span class=\"t-window-title\">Выберите вложения, которые необходимо скачать</span><div class=\"t-window-actions t-header\"><a class=\"t-window-action t-link\" href=\"\"><span class=\"t-icon t-close\">Close</span></a></div></div><div class=\"t-window-content t-content\" style=\"overflow:hidden;width:600px\"></div></div>\r\n\r\n\r\n\r\n\r\n</div>\r\n                                    </td>\r\n                                </tr>\r\n                            </table>\r\n                        </td>\r\n                    </tr>\r\n                </table>\r\n                <div id=\"footer\" class=\"td_footer\" style=\"margin-right:20px\">Страница сгенерирована за 2368 мс. ELMA v. 3.13.30.42998 R.3ed0fa02d2a822</div>\r\n                    <div class=\"td_footer\" style=\"margin-right: 20px; color: #F04040;\">\r\n                        На странице используются представления, заданные в конфигурации, которые в будущих версиях будут удалены.<br />Нужно <a href='http://www.elma-bpm.ru/kb/article-507.html' target='_blank' style='color:inherit;text-decoration:underline;font-weight: bold;'>удалить</a> эти представления из папки с конфигурацией и <a href='http://www.elma-bpm.ru/kb/article-507.html' target='_blank' style='color:inherit;text-decoration:underline;font-weight: bold;'>произвести соответствующие изменения в форме представления в дизайнере</a>,<br />иначе после обновления страница может отобразиться неправильно или не отобразиться совсем.\r\n                        <br />\r\n                        \r\n\r\n<script type=\"text/javascript\">\r\n    function ClickExpandObsoleteViews_Paths(e) {\r\n        if (!e) e = window.event;\r\n        if (e) {\r\n            var tgt = e.target || e.srcElement;\r\n            if (tgt.nodeName == 'A')\r\n                return;\r\n        }\r\n        $('#ObsoleteViews_Paths').toggleClass('collapsed');\r\n                    elma.dynamics.statictoggle('ajaxPanel_ObsoleteViews_Paths', 'imgClose_ObsoleteViews_Paths', 'imgOpen_ObsoleteViews_Paths', 'headerText_ObsoleteViews_Paths', 'Пути к предстaвлениям', 'Пути к предстaвлениям');\r\n\r\n\r\n            }\r\n</script>\r\n\r\n<div id=\"ObsoleteViews_Paths\" class=\"collapsible-panel collapsed\">\r\n    <div class=\"collapsible-panel-header \" onclick=\"ClickExpandObsoleteViews_Paths(event);\">\r\n        <span id=\"imgClose_ObsoleteViews_Paths\" class=\"collapseImage\" style=\"display:none\"></span>\r\n        <span id=\"imgOpen_ObsoleteViews_Paths\" class=\"expandImage\" style=\"inline-block\"></span>\r\n                <span id=\"headerText_ObsoleteViews_Paths\" class=\"title\">\r\n            Пути к предстaвлениям\r\n        </span>\r\n        </div>\r\n</div>\r\n     <div id=\"ajaxPanel_ObsoleteViews_Paths\" style=\"display:none\" collapsiblepanelid=\"ObsoleteViews_Paths\">\r\n\r\nC:\\ELMA3-Enterprise\\UserConfig\\WebApplication\\Modules\\EleWise.ELMA.Workflow.Web\\Views\\WorkflowTask\\Execute.cshtml\r\n                                     </div>\r\n\r\n                    </div>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n    <script type=\"text/javascript\">\r\n        var startMenuHashCode = 1260286191;\r\n    </script>\r\n\r\n    <script type=\"text/javascript\">\r\n    elma.addRegisteredScripts('ClientSearchRequestPopupgab3cfa50_5ba8_45d3_b059_2bbc55be632c','UploadFilesProgress','HistoryOrdering','TaskExtendedViewValidator','TaskAddQuestionFunc','Locko_WorkflowTaskExecuteExtensionWindow','ProcessImprovementPopup','Locko_CalendarWindow','PreviewPopup','DownloadPreviewSelector','PreviewAjaxBinding','Locko_FeedbackWindow');\r\n</script>\r\n \r\n\r\n\r\n<div class=\"t-widget t-window\" id=\"ClientSearchRequestPopupgab3cfa50_5ba8_45d3_b059_2bbc55be632c\" style=\"display:none\"><div class=\"t-window-titlebar t-header\">&nbsp;<span class=\"t-window-title\">Поиск клиента</span><div class=\"t-window-actions t-header\"><a class=\"t-window-action t-link\" href=\"\"><span class=\"t-icon t-close\">Close</span></a></div></div><div class=\"t-window-content t-content\" style=\"overflow:hidden;width:700px\"></div></div> \r\n                                                     \r\n\r\n\r\n<div class=\"t-widget t-window\" id=\"UploadFilesProgress\" style=\"display:none\"><div class=\"t-window-titlebar t-header\">&nbsp;<span class=\"t-window-title\">Файлы загружаются</span><div class=\"t-window-actions t-header\"><a class=\"t-window-action t-link\" href=\"\"><span class=\"t-icon t-close\">Close</span></a></div></div><div class=\"t-window-content t-content\" style=\"overflow:hidden;width:600px\"><div class='elma-window-toolbar'></div><div class='elma-window-content'>\r\n                                                                                          <div>\r\n                                                                                              <table class=\"table-form upload_info_table\">\r\n                                                                                              <tr>\r\n                                                                                                      <td colspan=\"2\" class=\"upload_info_table_header\">\r\n                                                                                                          <span id=\"UploadFilesProgressBarOperation\"></span>...\r\n                                                                                                      </td>\r\n                                                                                                  </tr>\r\n                                                                                                  <tr>\r\n                                                                                                      <td colspan=\"2\" class=\"upload_info_table_header\">\r\n                                                                                                          <div id=\"UploadFilesProgressBarLabel\">\r\n                                                                                                          </div>\r\n                                                                                                      </td>\r\n                                                                                                  </tr>\r\n                                                                                                  <tr>\r\n                                                                                                      <td colspan=\"2\">\r\n                                                                                                          <div id=\"UploadFilesProgressBar\">\r\n                                                                                                          </div>\r\n                                                                                                      </td>\r\n                                                                                                  </tr>\r\n                                                                                                  <tr>\r\n                                                                                                      <td style=\"width: 50%; white-space: nowrap;\">\r\nСкорость: &nbsp; <span id=\"UploadFilesProgressSpeed\"></span>\r\nkb/s\r\n                                                                                                      </td>\r\n                                                                                                      <td style=\"text-align: right;\">\r\n                                                                                                          <div id=\"UploadFilesProgressFilesCount\">\r\n                                                                                                          </div>\r\n                                                                                                      </td>\r\n                                                                                                  </tr>\r\n                                                                                              </table>\r\n                                                                                          </div>\r\n                                                                                      </div></div></div>    <script type=\"text/javascript\">\r\n        $(document).ready(function () {\r\n            $('#UploadFilesProgress').find('.t-header').first().hide();\r\n        });\r\n    </script>\r\n\r\n                                                 \r\n        <script type=\"text/javascript\">\r\n            function historyOrdering(sender, historyContainer) {\r\n                var historyLoaded = $('#' + historyContainer + '_historyLoadButton').hasClass('history-load-button-historyloaded');\r\n                var orderDesc = $(sender).find('.history-order-asc').is(':visible');\r\n                if (orderDesc) {\r\n                    $(sender).find('.history-order-asc').hide();\r\n                    $(sender).find('.history-order-desc').show();\r\n                    if (!historyLoaded) {\r\n                        $(\"#\" + historyContainer + \"_order\").val('True')\r\n                    }\r\n                } else {\r\n                    $(sender).find('.history-order-asc').show();\r\n                    $(sender).find('.history-order-desc').hide();\r\n                    if (!historyLoaded) {\r\n                        $(\"#\" + historyContainer + \"_order\").val('False')\r\n                    }\r\n                }\r\n                $.ajax('/Common/EntityHistory/OrderDescHistory', {\r\n                    data: { orderDesc: orderDesc },\r\n                });\r\n                if (!historyLoaded) {\r\n                    $('#' + historyContainer).html(\"<div id='\" + historyContainer + \"_nextHistoryBlock'></div>\");\r\n                    $('#' + historyContainer + '_historyLoadButton').attr('currentUnitOfWorkLoaded', null);\r\n                    $('#' + historyContainer + '_historyLoadButton').attr('packageIndex', 0);\r\n                    $('#' + historyContainer + '_historyLoadButton').attr('lastActionDate', null);\r\n                    $('#' + historyContainer + '_historyLoadButton').removeClass('history-load-button-historyloaded');\r\n                    $(\"#\" + historyContainer + \"_historyNextUnitOfWork\").show();\r\n                    loadHistoryByUnitOfWork(historyContainer);\r\n                } else {\r\n                    var container = $('#' + historyContainer);\r\n                    container.append(container.find('.history-item').reverse());\r\n                }\r\n            }\r\n        </script>\r\n    \r\n\r\n\r\n\r\n\r\n\r\n\r\n<script type=\"text/javascript\">\r\n     function GetAdditionalDocuments() {\r\n        var res = new Array();\r\n        \r\n         return res;\r\n     }\r\n\r\n    function SendTaskReassigne(submitButton) {\r\n        var form;\r\n        if (submitButton.document && submitButton.document.body) {\r\n            form = $(submitButton.document.body).find('form');\r\n        }\r\n        else if ($(submitButton).is('form')) {\r\n            form = $(submitButton);\r\n        }\r\n        else {\r\n            var formId = submitButton.form.id;\r\n            form = $('#' + formId);\r\n        }\r\n        if (!form)\r\n            return;\r\n        var selected = form.find('#Executor_Id');\r\n        var documents = [];\r\n        var addDocuments = GetAdditionalDocuments();\r\n        for (var i = 0; i < addDocuments.length; i++) {\r\n            documents.push(addDocuments[i]);\r\n        }\r\n        elma.AddPermissionsToDocument(form, [selected.val()], documents);\r\n    }\r\n</script>\r\n\r\n        <script type=\"text/javascript\">\r\n            function AddQuestion(objectId, objectTypeUid, userId, addQuestionActionUid, redirectUrl, beforeSubmitScript) {\r\n                var windowId = \"AddQuestionPopup\";\r\n                var url = '/Tasks/Question/QuestionCreateForm?PostAction=SaveQuestion&PostController=Question&PostArea=EleWise.ELMA.BPM.Web.Tasks&IsAjax=true'\r\n                    + '&ObjectTypeUid=' + objectTypeUid\r\n                    + '&Question.Executor.Id=' + userId\r\n                    + '&PopupId=' + windowId\r\n                    + '&ObjectId=' + objectId\r\n                    + '&AddQuestionActionUid=' + (addQuestionActionUid == null || addQuestionActionUid == \"\" ? \"bd4abee0-5880-466a-a0ad-b5da431a52fa\" : addQuestionActionUid)\r\n                    + '&RedirectUrl=' + redirectUrl\r\n                    + '&BeforeSubmitScript=' + beforeSubmitScript;\r\n                refreshPopup(windowId, url, null, \"Добавить вопрос\");\r\n            }\r\n        </script>\r\n    <script type=\"text/javascript\">\r\n    $(document).ready(function () {\r\n        $('[uid=\"TaskActions_ActionsButton\"]').hide();\r\n    });\r\n</script>\r\n\r\n\r\n\r\n<div class=\"t-widget t-window\" id=\"ProcessImprovementPopup\" style=\"display:none\"><div class=\"t-window-titlebar t-header\">&nbsp;<span class=\"t-window-title\">Улучшение процесса</span><div class=\"t-window-actions t-header\"><a class=\"t-window-action t-link\" href=\"\"><span class=\"t-icon t-close\">Close</span></a></div></div><div class=\"t-window-content t-content\" style=\"overflow:hidden;width:500px\"><div class='elma-window-toolbar'></div><div class='elma-window-content'></div></div></div>\r\n\r\n\r\n<div class=\"t-widget t-window\" id=\"Locko_CalendarPopup\" style=\"display:none\"><div class=\"t-window-titlebar t-header\">&nbsp;<span class=\"t-window-title\">Календарь встреч</span><div class=\"t-window-actions t-header\"><a class=\"t-window-action t-link\" href=\"\"><span class=\"t-icon t-close\">Close</span></a></div></div><div class=\"t-window-content t-content\" style=\"overflow:hidden;width:700px\"></div></div>\r\n\r\n<script type=\"text/javascript\">\r\n    function Locko_CalendarPopup()\r\n    {\r\n        refreshPopup('Locko_CalendarPopup', '/Locko.ELMA.Credit.Web/Calendar/CalendarTablePartial', null, 'Календарь встреч');\r\n    }\r\n</script>\r\n\r\n\r\n\r\n<div class=\"t-widget t-window\" id=\"PreviewPopup\" style=\"display:none\"><div class=\"t-window-titlebar t-header\">&nbsp;<span class=\"t-window-title\">Предпросмотр</span><div class=\"t-window-actions t-header\"><a class=\"t-window-action t-link\" href=\"\"><span class=\"t-icon t-close\">Close</span></a></div></div><div class=\"t-window-content t-content\" style=\"overflow:hidden\"></div></div>\r\n\r\n\r\n<div class=\"t-widget t-window\" id=\"DownloadPreviewSelector\" style=\"display:none\"><div class=\"t-window-titlebar t-header\">&nbsp;<span class=\"t-window-title\">Выбрать действие</span><div class=\"t-window-actions t-header\"><a class=\"t-window-action t-link\" href=\"\"><span class=\"t-icon t-close\">Close</span></a></div></div><div class=\"t-window-content t-content\" style=\"overflow:hidden\"></div></div>\r\n                                                    <script type=\"text/javascript\">\r\n                                                        $(document).ready(function() {\r\n                                                            $('#DownloadPreviewSelector').find('.t-window-content').css('overflow', 'visible');\r\n                                                        });\r\n                                                        function PreviewAjaxBinding(renderer, uniquePrefix, noevent) {\r\n                                                            var height = $(window).height() - 150;\r\n                                                            var width = $(window).width() - 200;\r\n                                                            $('#PreviewPopup').find('.t-window-content').css({\r\n                                                                width: width\r\n                                                            });\r\n                                                            $('#PreviewPopupInner').css({\r\n                                                                height: height\r\n                                                            });\r\n                                                            var win = getWindow('PreviewPopup');\r\n                                                            var isComplete = $('#RendererContainer' + uniquePrefix).length > 0;\r\n                                                            if (!isComplete) {\r\n                                                                win.center();\r\n                                                                setTimeout(function() {\r\n                                                                    PreviewAjaxBinding(renderer, uniquePrefix, true);\r\n                                                                }, 2000);\r\n                                                                return;\r\n                                                            }\r\n                                                            if (!noevent) {\r\n                                                                $(win.element).bind('refresh', function () {\r\n                                                                    $('#PreviewPopupInner').find('.fit-to-container').height(height);\r\n                                                                    $('#PreviewPopupInner').find('.fit-to-container').trigger('heightChanged');\r\n                                                                    PreviewAjaxBindingRenderes(renderer, uniquePrefix);\r\n                                                                });\r\n                                                            } else {\r\n                                                                $('#PreviewPopupInner').find('.fit-to-container').height(height);\r\n                                                                $('#PreviewPopupInner').find('.fit-to-container').trigger('heightChanged');\r\n                                                                PreviewAjaxBindingRenderes(renderer, uniquePrefix);\r\n                                                            }\r\n                                                            win.center();\r\n                                                        }\r\n\r\n                                                        function PreviewAjaxBindingRenderes(renderer, uniquePrefix) {\r\n                                                                         if (renderer == 'b4b61339-e0f2-471f-8168-e27834f846a2') {\r\n                                                                           try { eval(jQuery.validator.format('InitPreview_{0}($(\"#PreviewPopup\"))', uniquePrefix)); } catch(ex) {}\r\n                                                                         }\r\n                                                                         if (renderer == 'aed98b53-42ec-4348-8e71-138f36c4d0d3') {\r\n                                                                           try { eval(jQuery.validator.format('InitPreview_{0}($(\"#PreviewPopup\"))', uniquePrefix)); } catch(ex) {}\r\n                                                                         }\r\n                                                                         if (renderer == 'b4b61339-e0f2-471f-8168-e27834f846a2') {\r\n                                                                           setTimeout(function() { try { eval(jQuery.validator.format('CalcPositionPreviewToolbar_{0}()', uniquePrefix)); } catch(ex) {} }, 2000);\r\n                                                                         }\r\n                                                                         if (renderer == 'aed98b53-42ec-4348-8e71-138f36c4d0d3') {\r\n                                                                           setTimeout(function() { try { eval(jQuery.validator.format('CalcPositionPreviewToolbar_{0}()', uniquePrefix)); } catch(ex) {} }, 2000);\r\n                                                                         }\r\n\r\n                                                        }\r\n                                                        function CenterPreviewWindow() {\r\n                                                            if ($('#PreviewPopup').length > 0) {\r\n                                                                \r\n                                                            }\r\n                                                        }\r\n                                                    </script>\r\n                                                \r\n\r\n\r\n<div class=\"t-widget t-window\" id=\"Locko_FeedbackPopup\" style=\"display:none\"><div class=\"t-window-titlebar t-header\">&nbsp;<span class=\"t-window-title\">Обратная связь</span><div class=\"t-window-actions t-header\"><a class=\"t-window-action t-link\" href=\"\"><span class=\"t-icon t-close\">Close</span></a></div></div><div class=\"t-window-content t-content\" style=\"overflow:hidden;width:700px\"></div></div>\r\n\r\n<script type=\"text/javascript\">\r\n    function Locko_FeedbackPopup(instanceId)\r\n    {\r\n        var postData = [];\r\n        postData[\"instanceId\"] = instanceId;\r\n        refreshPopup('Locko_FeedbackPopup', '/Locko.ELMA.Common.Web/Feedback/FeedbackButtonPopup', $.extend({}, postData), 'Обратная связь');\r\n    }\r\n</script>\r\n\r\n                                                           \r\n\r\n\r\n<div class=\"t-widget t-window\" id=\"AddEntityPermission\" style=\"display:none\"><div class=\"t-window-titlebar t-header\">&nbsp;<span class=\"t-window-title\">Предоставление прав доступа</span><div class=\"t-window-actions t-header\"><a class=\"t-window-action t-link\" href=\"\"><span class=\"t-icon t-close\">Close</span></a></div></div><div class=\"t-window-content t-content\" style=\"overflow:hidden\"><div class='elma-window-toolbar'></div><div class='elma-window-content'> </div></div></div>    <script type=\"text/javascript\">\r\n        elma.AddPermissionsToDocument = function (form, executors, documents, submitScript, labelText) {\r\n            if (!$(form).valid()) {\r\n                return;\r\n            }\r\n            var formId = $(form).attr(\"id\");\r\n            if (!formId || formId == '')\r\n                jAlert('Не задан идентификатор формы');\r\n            if (!submitScript || submitScript == '')\r\n                submitScript = 'elma.openPleaseWait(true);$(\"#' + formId + '\").submit();';\r\n            var postData = '';\r\n            for (var i = 0; i < executors.length; i++) {\r\n                if (i != 0)\r\n                    postData += '&';\r\n                postData += 'userIds[' + i + ']=' + executors[i];\r\n            }\r\n            for (var j = 0; j < documents.length; j++) {\r\n                postData += '&id=' + documents[j];\r\n            }\r\n            if (labelText) {\r\n                postData += '&labelText=' + labelText;\r\n            } else {\r\n                postData += '&labelText=У выбранных пользователей нет прав на некоторые документы';\r\n            }\r\n            elma.openPleaseWait(true);\r\n            $.ajax({\r\n                cache: false,\r\n                type: 'POST',\r\n                url: '/Security/PermissionManagment/NeedAddPermissionToEntity?permission=EBD6105A-AB44-404D-8B03-1D260EBB2881&type=EleWise.ELMA.Documents.Models.DmsObject%2C%20EleWise.ELMA.DynamicModel%2C%20Version%3D1.0.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3Dnull',\r\n                data: postData,\r\n                success: function (data) {\r\n                    if (data.result) {\r\n                        var url = '/Security/PermissionManagment/EntityAddPermission?popupId=AddEntityPermission&permission=EBD6105A-AB44-404D-8B03-1D260EBB2881&type=EleWise.ELMA.Documents.Models.DmsObject%2C%20EleWise.ELMA.DynamicModel%2C%20Version%3D1.0.0.0%2C%20Culture%3Dneutral%2C%20PublicKeyToken%3Dnull&defaultPermissions%5B0%5D=EBD6105A-AB44-404D-8B03-1D260EBB2881&defaultPermissions%5B1%5D=0DF08F58-8BBB-40A7-AB4E-BDB1BD6A459E';\r\n                        refreshPopup('AddEntityPermission', url, 'submitScript=' + escape(submitScript) + '&' + postData, null, function() { elma.closePleaseWait(true); });\r\n                    } else {\r\n                        $('#' + formId).submit();\r\n                    }\r\n                }\r\n            });\r\n        }\r\n    </script>\r\n \r\n                                                       \r\n\r\n    <script type=\"text/javascript\">\r\n//<![CDATA[\r\njQuery(document).ready(function(){\r\njQuery('#Task_MainTabLayout').tTabStrip({onSelect:function (e) { ; setTimeout(function() { $(document).trigger('resizeLayout'); }, 100); }, onContentLoad:elma.onAjaxStop});\r\njQuery('#Entity_Application_UnderwriterTabLayout').tTabStrip({onSelect:function (e) { ; setTimeout(function() { $(document).trigger('resizeLayout'); }, 100); }, onContentLoad:elma.onAjaxStop});\r\njQuery('#d2b8c105-c4a6-440c-9fa6-e1fe41414a45_2_ViewItemPopup').tWindow({onClose:onWindowClose, onOpen:onWindowOpen, onActivate:onWindowActivate, onRefresh:onWindowRefresh, modal:true, contentUrl:'/Common/Catalogs/ViewItem/2?uid=d2b8c105-c4a6-440c-9fa6-e1fe41414a45&inPopUp=True', draggable:true, resizable:false});\r\njQuery('#6fa7abf3-a636-4f4b-8496-9c7017796db2_1084404_ViewItemPopup').tWindow({onClose:onWindowClo
oaded=\"null\" onclick=\"loadHistoryByUnitOfWork('Entity_Application_61848fa9_3e76_4458_997e_4c7927f6235f_759219')\"><img class=\"wait\" src=\"/Content/Images/x16/wait.gif\"></img></div>\r\n    </div>\r\n    <script type=\"text/javascript\">\r\n        $(document).ready(function () {\r\n            CheckHistoryButtonVisibility('Entity_Application_61848fa9_3e76_4458_997e_4c7927f6235f_759219');\r\n        });\r\n        $(window).scroll(function () {\r\n            CheckHistoryButtonVisibility('Entity_Application_61848fa9_3e76_4458_997e_4c7927f6235f_759219');\r\n        });\r\n\r\n        function CheckHistoryButtonVisibility(historyBlockId) {\r\n            var button = $('#' + historyBlockId + '_historyLoadButton');\r\n\r\n            if (button.length == 0 || button.hasClass(\"history-load-button-wait\") || button.hasClass(\"history-load-button-historyloaded\"))\r\n            {\r\n                return;\r\n            }\r\n\r\n            var scrollTop = $(window).scrollTop();\r\n            var windowHeight = $(window).height();\r\n            var offset = button.offset();\r\n\r\n            if (scrollTop <= offset.top && (button.height() + offset.top) < (scrollTop + windowHeight))\r\n            {\r\n                loadHistoryByUnitOfWork(historyBlockId);\r\n            }\r\n        }\r\n\r\n        function loadHistoryByUnitOfWork(historyBlockId, lastActionDate) {\r\n            var element = $('#' + historyBlockId + '_historyLoadButton');\r\n            if (element.hasClass(\"history-load-button-wait\") || element.hasClass(\"history-load-button-historyloaded\"))\r\n            {\r\n                return;\r\n            }\r\n\r\n            element.addClass(\"history-load-button-wait\");\r\n\r\n            var historyBlocks = $(\"#\" + historyBlockId);\r\n            var nextHistoryBlocks = $(\"#\" + historyBlockId + \"_nextHistoryBlock\");\r\n            var firstResult = Number(element.attr(\"currentUnitOfWorkLoaded\"));\r\n            var lastActionDate = element.attr(\"lastActionDate\");\r\n            var packageIndex = Number(element.attr(\"packageIndex\"));\r\n\r\n            $.ajax({\r\n                global: true,\r\n                cache: false,\r\n                type: 'GET',\r\n                url: '/Common/EntityHistory/HistoryPart/759219?actionObject=4ba4f2f6-bff3-41ca-b3be-56261afc2219&maxResults=10',\r\n                data: { \"firstResult\": firstResult, \"orderDesc\": $(\"#\" + historyBlockId + \"_order\").val(), \"lastActionDate\": lastActionDate, \"packageIndex\": packageIndex},\r\n                success: function (data) {\r\n                    nextHistoryBlocks.html(data.html);\r\n                    nextHistoryBlocks.attr(\"id\", historyBlockId + \"_loadedHistoryBlock\");\r\n                    historyBlocks.append(\"<div id='\" + historyBlockId + \"_nextHistoryBlock'></div>\");\r\n                    $('#' + historyBlockId + '_historyLoadButton').removeClass(\"history-load-button-wait\");\r\n                    $('#' + historyBlockId + '_historyLoadButton').attr(\"currentUnitOfWorkLoaded\", data.info.lastId);\r\n                    $('#' + historyBlockId + '_historyLoadButton').attr(\"lastActionDate\", data.info.lastActionDate);\r\n                    $('#' + historyBlockId + '_historyLoadButton').attr(\"packageIndex\", data.info.packageIndex);\r\n                    var wall = $('#' + historyBlockId + '_wall');\r\n                    wall.find(\".history-item\").show();\r\n                    var arr = $('a').filter(function () { return $(this).data('wallid') == historyBlockId + '_wall' });\r\n                    for (var i = 0; i < arr.length; i++) {\r\n                        var element = arr[i];\r\n                        var selected = $(element).hasClass('selected');\r\n                        var subclass = $(element).data(\"typeclass\");\r\n                        wall.find(\".history-type-\" + subclass).attr(\"historyVisible\", selected);\r\n                        if (!selected) {\r\n                            wall.find(\".history-type-\" + subclass).hide();\r\n                        } else {\r\n                            wall.find(\".history-type-\" + subclass).show();\r\n                        }\r\n                    }\r\n                    wall.find(\".history-item:not(:has(.history-item-ext[historyVisible=true]))\").hide();\r\n                    if (!data || data.info.lastPackage == true) {\r\n                        $(\"#\" + historyBlockId + \"_historyNextUnitOfWork\").hide();\r\n                        $('#' + historyBlockId + '_historyLoadButton').addClass(\"history-load-button-historyloaded\");\r\n                    } else {\r\n                        CheckHistoryButtonVisibility(historyBlockId);\r\n                    }\r\n                }\r\n            });\r\n        }\r\n    </script>\r\n</div>                         </div>\r\n\r\n                     </div></div>\r\n</div>\r\n\r\n\r\n\r\n<div style=\"padding:10px;\">\r\n    <table>\r\n            <tr>\r\n                <td style=\"padding-bottom: 5px;\">\r\n                    <input type=\"button\" class=\"green\" id=\"conaff4e571e66d4eb49802f6d5d7785922\" name=\"conaff4e571e66d4eb49802f6d5d7785922\" value=\"Обработать\" onclick=\"var clickCode = function () { $(&#39;#SelectedConnectorUid&#39;).val(&#39;aff4e571-e66d-4eb4-9802-f6d5d7785922&#39;);checkAndSubmit($($(&#39;#ContextDynamicForm_db63d82556924a8e81f32dcedd88962f&#39;)).closest(&#39;form&#39;), false); }; elma.SubTaskActions.CheckActiveSubTasks(1512579, clickCode, [], &#39;&#39;);\"/>\r\n                                    </td>\r\n                <td style=\"vertical-align: middle;\"><span class=\"comment\"></span></td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding-bottom: 5px;\">\r\n                    <input type=\"button\" class=\"yellow\" id=\"con539a74d3191945eda9e17da70ffe363b\" name=\"con539a74d3191945eda9e17da70ffe363b\" value=\"Сохранить\" onclick=\"var clickCode = 
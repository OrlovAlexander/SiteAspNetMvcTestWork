TemplateMode(&quot;Entity_Application_SignMSB_Id&quot;)\"><img class=\"combobox-template-edit-icon\" src=\"/Content/Images/x16/cursor.png\"></img></span></div><input id=\"Entity_Application_SignMSB_Id\" name=\"Entity.Application.SignMSB.Id\" type=\"hidden\" /></div>    </td></tr></table>\r\n<input type=\"hidden\" class=\"Entity_Application_SignMSB_Id_json\" id=\"Entity_Application_SignMSB_validate\" name=\"Entity.Application.SignMSB_validate\" />\r\n    <input type=\"hidden\" class=\"deleted autocompliteValidateField\" id=\"Entity_Application_SignMSB\" name=\"Entity.Application.SignMSB\" />\r\n<script type=\"text/javascript\">\r\n    function CreateEntityPopupGetParamse2e1a8ea_fa7c_4497_8ffe_7c8b43cf3072() {\r\n        var data = '';\r\n        return data;\r\n    }\r\n</script>\r\n<script type=\"text/javascript\">\r\n    jQuery(document).ready(function () {\r\n        if ('Entity.Application.SignMSB' == 'Entity.Application.SignMSB.Id') {\r\n            $('#Entity_Application_SignMSB_Id').addClass('autocompliteValidateField');\r\n        }\r\n        elma.ValidationRulesManager.add('Entity_Application_SignMSB');\r\n            elma.ValidationRulesManager.executeMove();\r\n    });\r\n</script>\r\n\r\n\r\n\r\n<div class=\"t-widget t-window\" id=\"CreateEntityPopupe2e1a8ea_fa7c_4497_8ffe_7c8b43cf3072\" style=\"display:none\"><div class=\"t-window-titlebar t-header\">&nbsp;<span class=\"t-window-title\">Работа с объектом &quot;Партнер&quot;</span><div class=\"t-window-actions t-header\"><a class=\"t-window-action t-link\" href=\"\"><span class=\"t-icon t-close\">Close</span></a></div></div><div class=\"t-window-content t-content\" style=\"overflow:hidden\"></div></div>\r\n</div>\r\n\r\n<script type=\"text/javascript\">\r\n    $(document).ready(function () {\r\n\r\n        var selector = elma.EntitySelector.Manager.create({\r\n            id: 'Entity_Application_SignMSB_Id',\r\n            inputName: 'Entity.Application.SignMSB.Id',\r\n            multiSelect: false,\r\n            selected: [],\r\n            itemFormat: '<a class=\"combobox-template-link combobox-template-text-element\" href=\"{item.EntityUrl}\" target=\"_blank\" tabindex=\"-1\">{item.Text}</a>',\r\n            itemFormatJsClick: '<a class=\"combobox-template-link combobox-template-text-element\" href=\"#\" onclick=\"{item.EntityUrl}\" tabindex=\"-1\">{item.Text}</a>'\r\n            });\r\n\r\n        $('#Entity_Application_SignMSB_Id').bind('valueChange', function(evt) {\r\n            if(evt.isImmediatePropagationStopped()) return;\r\n\r\n            var combobox = $('#Entity_Application_SignMSB_Id').data(\"tComboBox\");\r\n            combobox.select(function(data) { return data.Value == evt.value; });\r\n            selector.addItem(evt.value, combobox.text(), combobox.text(), true);\r\n        });\r\n\r\n\r\n        selector.onAddItem(function(evt, item) {\r\n            if(evt.isImmediatePropagationStopped() || item.stopEvent) return;\r\n\r\n            var combobox = $('#Entity_Application_SignMSB_Id').data(\"tComboBox\");\r\n            var previousValue = combobox.previousValue;\r\n\r\n            if (previousValue != item.val) {\r\n\r\n                var s = false;\r\n\r\n                combobox.select(function(data) {\r\n                    return s = data.Value == item.val;\r\n                });\r\n\r\n                if(!s) {\r\n                    combobox.reloadSelect(item.val + '');\r\n                } else {\r\n                    combobox.previousValue = previousValue;\r\n                    combobox.trigger.change();\r\n                }\r\n            }\r\n        });\r\n\r\n        selector.onRemoveItem(function(evt, item) {\r\n\r\n            var node = $('div.Entity_Application_SignMSB_Id input[value=\"' + item.val + '\"]');\r\n            var id = 'Entity_Application_SignMSB_Id';\r\n            var comboNameArray = id.split(\"_\");\r\n            var comboNamePrefix = id;\r\n            var comboNameSuffix = \"\";\r\n\r\n            if (comboNameArray.length > 1)\r\n            {\r\n                comboNameSuffix = \".\" + comboNameArray[comboNameArray.length - 1];\r\n                comboNameArray.pop();\r\n                comboNamePrefix = comboNameArray.join('.');\r\n            }\r\n\r\n            onClearItem(node.parent(), comboNamePrefix, comboNameSuffix);\r\n        });\r\n    });\r\n</script>\r\n\r\n<script type=\"text/javascript\">\r\n    $(document).ready(function() {\r\n        var comboboxId = 'Entity_Application_SignMSB_Id';\r\n        locko.waitUntil(function () {\r\n            var combobox = elma.extractComboBox($(\"#\" + comboboxId));\r\n            if (combobox == null)\r\n            {\r\n                var input = $(\"#\" + comboboxId);\r\n                if (input.length != 0 && input.parents(\".t-combobox:first\").length == 0)\r\n                {\r\n                    return true;\r\n                }\r\n            }\r\n            return combobox != null;\r\n        }, function () {\r\n            var combobox = elma.extractComboBox($(\"#\" + comboboxId));\r\n            if (combobox == null)\r\n                return;\r\n            combobox.lockoInit = true;\r\n        });\r\n    });\r\n</script>\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<div class=\"t-widget t-window\" id=\"EntityPopupEntity_Application_SignMSB_Id\" style=\"display:none\"><div class=\"t-window-titlebar t-header\">&nbsp;<span class=\"t-window-title\">Выберите элемент</span><div class=\"t-window-actions t-header\"><a class=\"t-window-action t-link\" href=\"\"><span class=\"t-icon t-close\">Close</span></a></div></div><div class=\"t-window-content t-content\" style=\"overflow:hidden;width:1100px\"></div></div><span class=\"field-validation-valid\" id=\"Entity_Application_SignMSB_validationMessage\"></span>\r\n    <div id=\"Entity_Application_SignMSB_DescriptionContainer\">\r\n    </div>\r\n</td></tr>\r\n</table></div>\r\n        </div>\r\n\r\n\r\n<div class=\"table-form-container\" style=\"\"><table clas
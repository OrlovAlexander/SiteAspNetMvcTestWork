n\t\t<tr>\r\n\t\t\t<td style=\"width:33.3%;\">\r\n\t\t\t\t<div class=\"table-form-container\" style=\"\"><table class=\"table-form\" style=\"\">\r\n\t\t\t\t\r\n\r\n\r\n<tr id=\"Entity_Application_PointOfSale_Container\"><td class=\"dft_table_td_inputs captionCell\" id=\"Entity_Application_PointOfSale_CaptionContainer\">Партнер/ Точка продаж\r\n</td><td id=\"Entity_Application_PointOfSale_ValueContainer\">        <span class=\"comment3\">Не выбрано</span>\r\n\r\n    <div id=\"Entity_Application_PointOfSale_DescriptionContainer\">\r\n    </div>\r\n</td></tr>\r\n\r\n\t\t\t\t</table></div>\r\n\t\t\t</td>\r\n\t\t\t<td style=\"width:33.3%;\">\r\n\t\t\t\t<div class=\"table-form-container\" style=\"\"><table class=\"table-form\" style=\"\">\r\n\t\t\t\t\r\n\r\n\r\n<tr id=\"Entity_Application_DownPayment_Container\"><td class=\"dft_table_td_inputs captionCell\" id=\"Entity_Application_DownPayment_CaptionContainer\">Первоначальный взнос (руб.)\r\n</td><td id=\"Entity_Application_DownPayment_ValueContainer\">    \r\n    <div id=\"Entity_Application_DownPayment_DescriptionContainer\">\r\n    </div>\r\n</td></tr>\r\n\r\n\t\t\t\t</table></div>\r\n\t\t\t</td>\r\n\t\t\t<td style=\"width:33.3%;\">\r\n\t\t\t\t<div class=\"table-form-container\" style=\"\"><table class=\"show-lines table-form\" style=\"\">\r\n\t\t\t\t\r\n\r\n\r\n<tr id=\"Entity_Application_PVInPercent_Container\"><td class=\"dft_table_td captionCell\" id=\"Entity_Application_PVInPercent_CaptionContainer\">Первоначальный взнос (%)\r\n</td><td id=\"Entity_Application_PVInPercent_ValueContainer\">            <span class=\"display-string\"></span>\r\n        \r\n\r\n<span class=\"field-validation-valid\" id=\"Entity_Application_PVInPercent_validationMessage\"></span>    <div id=\"Entity_Application_PVInPercent_DescriptionContainer\">\r\n    </div>\r\n</td></tr>\r\n\r\n\t\t\t\t</table></div>\r\n\t\t\t</td>\r\n\t\t</tr>\r\n\t</table>\r\n<div id=\"PropertiesOfPointOfSale\" style=\"padding-left:10px; line-height: 1.5;\"></div>\r\n<table id=\"totalCost\" width=\"100%\">\r\n    <tbody>\r\n        <tr>\r\n            <td style=\"text-align:right; vertical-align:middle; width:75%; padding-right:10px\">\r\n                <div>\r\n                    Итоговая стоимость\r\n\r\n                </div>\r\n            </td>\r\n            <td>\r\n                <div>\r\n0,00                </div>\r\n            </td>\r\n        </tr>\r\n    </tbody>\r\n</table>\r\n\r\n\r\n<script type=\"text/javascript\">\r\n    $(function () {\r\n        jQuery.validator.addMethod(\"checkPOSPercent\", function (value, element) {\r\n            if (value == null || $.trim(value) == '')\r\n                return true;\r\n\r\n            var comboboxId = \"#Entity_Application_LoanPurpose_Id\";\r\n            locko.waitUntil(function () {\r\n                var combobox = elma.extractComboBox($(comboboxId));\r\n                return combobox != null;\r\n            }, function () {\r\n                var combobox = elma.extractComboBox($(comboboxId));\r\n                if (typeof combobox !== 'undefined' && combobox != null && typeof combobox.data !== 'undefined' && combobox.data != null) {\r\n                    var selectedValue = combobox.data[combobox.selectedIndex];\r\n                    if (!isEmpty(selectedValue)) {\r\n                        var code = selectedValue.Code;\r\n                        if (code == 19) {\r\n                            var percent = findPOSPercent();\r\n                            return (percent > 0);\r\n                        }\r\n                    }\r\n                }\r\n            });\r\n\r\n            return true;\r\n        });\r\n    });\r\n\r\n    $(document).ready(function() {\r\n            \r\n                var parent = $('#posPanel').closest('div[id^=\"ajaxPanel\"]');\r\n                parent.hide();\r\n                var id = $(parent).attr('id').replace('ajaxPanel_', '');\r\n                $('#'+id).hide();\r\n            \r\n\t\t            \r\n                POSCollectionForView();\r\n            \r\n            });\r\n\r\n    function findPOSPercent() {\r\n\t\tvar totalCost;\r\n\t\tvar payment;\r\n\t\tif (false)\r\n\t\t{\r\n\t\t\ttotalCost = parseFloat($('#Entity_Application_TotalCostPOS').val().replaceAll('&nbsp;', '').replaceAll(' ', '').replace(',', '.'));\r\n\t\t\tpayment = parseFloat($('#Entity_Application_DownPayment').val().replaceAll('&nbsp;', '').replaceAll(' ', '').replace(',', '.'));\r\n\t\t}\r\n\t\telse\r\n\t\t{\r\n\t\t\ttotalCost = parseFloat($('#totalCost').find('td').last().get(0).innerText.replaceAll('&nbsp;', '').replaceAll(' ', '').replace(',', '.'));\r\n\t\t\tvar payment = parseFloat($('#Entity_Application_DownPayment_Container').find('td').last().get(0).innerText.replaceAll('&nbsp;', '').replaceAll(' ', '').replace(',', '.'));\r\n\t\t}\r\n        if (totalCost && payment) {\r\n            var percent = payment/totalCost*100.0;\r\n            return Math.round((percent + Number.EPSILON) * 10) / 10;\r\n        }\r\n        return 0;\r\n    }\r\n\r\n    function POSPaymentRecalc() {\r\n        $($('#Entity_Application_PVInPercent_ValueContainer').children('span.display-string')).html(findPOSPercent());\r\n    }\r\n\r\n\tfunction GetProperties(id) {\r\n\t\t$('#PropertiesOfPointOfSale').html('');\r\n\t\tif (id > 0) {\r\n\t\t\tvar url = '/Locko.ELMA.Credit.Web/CreditIntegration/GetPropertiesOfPointOfSale';\r\n\t\t\telma.openPleaseWait(true);\r\n\t\t\t\t$.ajax({\r\n\t\t\t\t\turl: url,\r\n\t\t\t\t\tdata: ({ id: id}),\r\n\t\t\t\t\ttype: \"POST\",\r\n\t\t\t\t\tsuccess: function (data) {\r\n                        {\r\n\t\t\t\t\t\t\tif(data != null) {\r\n\t\t\t\t\t\t\t\tif(data.generalPartner != null && data.generalPartner.length > 0) {\r\n\t\t\t\t\t\t\t\t\t$('#PropertiesOfPointOfSale').html(`Генеральный партнер: ${data.generalPartner}</br>`);\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\tif(data.contractor != null && data.contractor.length > 0) {\r\n\t\t\t\t\t\t\t\t\t$('#PropertiesOfPointOfSale').html($('#PropertiesOfPointOfSale').html() + `Контрагент: ${data.contractor}`);\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t}\r\n                    },\r\n                    complete: function () {\r\n                        elma.closePleaseWait(true);\r\n                    }\r\n\t\t\t\t});\r\n\t\t}\r\n\t}\r\n\r\n\tfunction RecalcAmountRequested() {\r\n\t\tvar totalCost = parseFloat($('#Entity_Application_TotalCostPOS').val().replaceAll('&nbsp;', '').replaceAll(' ', '').replace(',', '.'));\r\n\t\tvar downPayment = $('#Entity_Application_DownPayment').val() > 0 ? parseFloat($('#Entity_Application_DownPayment').val().replaceAll('&nbsp;', '').replaceAll(' ', '').replace(',', '.')) : 0.00;\r\n\t\tvar diff = totalCost - downPayment;\r\n\t\tvar strDiff = number_format(Math.abs(diff), 2, ',', ' ');\r\n\t\t$('#Entity_Application_AdditionalProperties_AmountRequested').val(diff);\r\n\t\tif ($('#Entity_Application_AdditionalProperties_AmountRequested_ValueContainer').find('.t-formatted-value').length > 0) {\r\n\t\t\t$('#Entity_Application_AdditionalProperties_AmountRequested_ValueContainer').find('.t-formatted-value').get(0).innerText = strDiff;\r\n\t\t}\r\n\t\tPOSPaymentRecalc();\r\n\t}\r\n\r\n\tjQuery.validator.addMethod('checkTotalCost', function() {\r\n\r\n                return $('#Entity_Application_TotalCostPOS').val() > 0;\r\n            },\r\n            \"Добавьте товар и укажите его стоимость\"\r\n        );\r\n\r\n        function ValidationTotalCostOn() {\r\n        locko.waitUntilValidatorReady('Entity_Application_TotalCostPOS', function () {\r\n            elma.ValidationRulesManager.addRule('Entity_Application_TotalCostPOS', 'add', {checkTotalCost: true});\r\n        });\r\n\t}\r\n\r\n\tfunction ValidationTotalCostOff() {\r\n        locko.waitUntilValidatorReady('Entity_Application_TotalCostPOS', function () {\r\n            elma.ValidationRulesManager.disible('Entity_Application_TotalCostPOS');\r\n        });\r\n\t}\r\n\r\n    function POSCollectionForView() {\r\n        var container = $('#Entity_Application_POS').parent();\r\n        container.find('.entity-collection-edit-icon').remove();\r\n        container.find('.entity-collection-delete-icon').remove();\r\n        container.parent().find('.button').last().hide();\r\n    }\r\n</script>\r\n        </div>\r\n</td></tr><tr class=\"\" hideCount=\"0\"><td class=\"table-SingleColumnItem\" colspan=\"2\">\r\n\r\n<span class=\"inline-property-value\" id=\"Entity_Application_POS_44a39766_316c_4a9d_b5e7_7acd399e1838_ValueContainer\">\r\n\r\n<div style=\"margin-top: 10px;\">POS товары:</div>\r\n<div style=\"background: #c0dcff; padding: 10px;\">\r\n    <table width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n        <tbody>\r\n            <tr>\r\n                <td style=\"width: 25%;\">\r\n                    Тип товара\r\n                </td>\r\n                <td style=\"width: 25%;\">\r\n                    Категория товара\r\n                </td>\r\n                <td style=\"width: 25%;\">\r\n                    Название товара\r\n                </td>\r\n                <td style=\"width: 25%;\">\r\n                    Стоимость товара\r\n                </td>\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n</div>\r\n<div id=\"posList\">\r\n    \r\n\r\n<div id=\"Containerc26b256c_0696_4fc1_87ad_f4b03938c7aa\" class=\"entity-collection-container\">\r\n    <input type=\"hidden\" class=\"Entity.Application.POS_Id\" id=\"Entity_Application_POS_Id\" name=\"Entity.Application.POS.Id\" oldvalue=\"\" value=\"\">\r\n    <input type=\"hidden\" class=\"Entity.Application.POS_json\" id=\"Entity_Application_POS_validate\" name=\"Entity.Application.POS_validate\" oldvalue=\"\" value=\"\">\r\n    <input type=\"hidden\" id=\"Entity_Application_POS\" name=\"Entity.Application.POS\" oldvalue=\"\" value=\"\">\r\n</div>\r\n\r\n<div style=\"margin-top: 10px;\"></div>\r\n\r\n<a class=\"button\" href=\"javascript:void(0)\" onclick=\"refreshPopupWithWidth(900, &#39;CreateEntityPopupfcd70dbf_cef0_4078_b024_b0900c1fdbf3&#39;, &#39;/Common/Entity/CreatorForm?creatorUid=00000000-0000-0000-0000-000000000000&amp;typeUid=ade3477e-d36d-4d1d-87f3-d9956d7f4102&amp;containerId=Containerc26b256c_0696_4fc1_87ad_f4b03938c7aa&amp;popupId=CreateEntityPopupfcd70dbf_cef0_4078_b024_b0900c1fdbf3&amp;parentHtmlPrefix=Entity.Application.POS&amp;openEntityCreator=openEntityCreator298efa41_21f9_48b0_8c84_469f9d058f2a(this)&amp;createEntityCallback=createEntityCallback298efa41_21f9_48b0_8c84_469f9d058f2a(data)&amp;viewFormUid=11ab4a8c-cb09-44fd-9ec7-457a96cb3067&#39;, null, &#39;Работа с объектом &quot;POS товары&quot;&#39;);return false;\"><img alt=\"Создать\" src=\"/Content/Images/x24/AddSmall.png\" style=\"vertical-align: middle;\" title=\"Создать\"></img><span style=\"vertical-align: middle;padding-left: 5px;\">Создать</span></a>\r\n\r\n\r\n<div class=\"t-widget t-window\" id=\"CreateEntityPopupfcd70dbf_cef0_4078_b024_b0900c1fdbf3\" style=\"display:none\"><div class=\"t-window-titlebar t-header\">&nbsp;<span class=\"t-window-title\">Работа с объектом &quot;POS товары&quot;</span><div class=\"t-window-actions t-header\"><a class=\"t-window-action t-link\" href=\"\"><span class=\"t-icon t-close\">Close</span></a></div></div><div class=\"t-window-content t-content\" style=\"overflow:hidden\"></div></div>\r\n\r\n\r\n\r\n<div class=\"t-widget t-window\" id=\"EditEntityPopup298efa41_21f9_48b0_8c84_469f9d058f2a\" style=\"display:none\"><div class=\"t-window-titlebar t-header\">&nbsp;<span class=\"t-window-title\">Редактирование записи</span><div class=\"t-window-actions t-header\"><a class=\"t-window-action t-link\" href=\"\"><span class=\"t-icon t-close\">Close</span></a></div></div><div class=\"t-window-content t-content\" style=\"overflow:hidden\"><div class='elma-window-toolbar'></div><div class='elma-window-content'></div></div></div>\r\n\r\n<script type=\"text/javascript\">\r\n    var currentIndex298efa41_21f9_48b0_8c84_469f9d058f2a = 0;\r\n    $(document).ready(function() {\r\n        $('.entity-collection-item').each(function() {\r\n            var item = $(this);\r\n            var editContainer = item.find('.entity-collection-edit-icon');\r\n            var deleteContainer = item.find('.entity-collection-delete-icon');\r\n            item.hover(function() {\r\n                item.addClass('active');\r\n editContainer.show();                deleteContainer.show();\r\n            }, function() {\r\n                editContainer.hide();\r\n                deleteContainer.hide();\r\n                item.removeClass('active');\r\n            });\r\n        });\r\n        $(\"#Entity_Application_POS\").val(currentIndex298efa41_21f9_48b0_8c84_469f9d058f2a > 0 ? currentIndex298efa41_21f9_48b0_8c84_469f9d058f2a : null);\r\n    });\r\n\r\n    function openEntityCreator298efa41_21f9_48b0_8c84_469f9d058f2a(form) {\r\n        $(form).validate();\r\n        if (!$(form).valid())\r\n            return;\r\n        var dropDownList = $(form).find(\"input[id^='SelectedType']\").data('tDropDownList');\r\n        var params = CreateEntityPopupGetParamsCreateEntityPopupfcd70dbf_cef0_4078_b024_b0900c1fdbf3(dropDownList.value());\r\n        openCreateEntityPopup(dropDownList.value(), params);\r\n    }\r\n\r\n    function createEntityCallback298efa41_21f9_48b0_8c84_469f9d058f2a(data) {\r\n        if (data != undefined && data != null) {\r\n            if (data.html != undefined && data.html != null && data.info != undefined && data.info != null) {\r\n                var item = $('<div></div>').addClass('entity-collection-item');\r\n\r\n                var formContainer = $('<div></div>').addClass('entity-collection-item-form');\r\n\r\n                var input = $('<input>').prop({\r\n                    type: 'hidden',\r\n                    name: 'Entity.Application.POS' + '[' + currentIndex298efa41_21f9_48b0_8c84_469f9d058f2a + '].Id',\r\n                    uid: data.info.typeUid\r\n                });\r\n\r\n                input.attr('uid', data.info.typeUid);\r\n                input.val(data.info.id);\r\n\r\n                currentIndex298efa41_21f9_48b0_8c84_469f9d058f2a++;\r\n                var editContainer = $('<div></div>').addClass('entity-collection-edit-icon');\r\n                var editImg = '<img src=\"/Content/Images/x24/Edit.png\" title=\"Редактировать\"></img>';\r\n                var editLink = $('<a></a>').addClass('button').prop('href', 'javascript:void(0)');\r\n                editLink.click(function (e) {\r\n                    elma.openPleaseWait();\r\n                    editItem298efa41_21f9_48b0_8c84_469f9d058f2a($(e.currentTarget).closest('div.entity-collection-item'));\r\n                    return false;\r\n                });\r\n                editLink.append(editImg);\r\n                editContainer.append(editLink);\r\n\r\n                var deleteContainer = $('<div></div>').addClass('entity-collection-delete-icon');\r\n                var deleteImg = '<img src=\"/Content/Images/x24/Delete.png\" title=\"Удалить\"></img>';\r\n                var deleteLink = $('<a></a>').addClass('button').prop('href', 'javascript:void(0)');\r\n                deleteLink.click(function (e) {\r\n                    deleteItem298efa41_21f9_48b0_8c84_469f9d058f2a($(e.currentTarget).closest('div.entity-collection-item'));\r\n                    return false;\r\n                });\r\n                deleteLink.append(deleteImg);\r\n                deleteContainer.append(deleteLink);\r\n\r\n                item.hover(function() {\r\n                    item.addClass('active');\r\n editContainer.show();                    deleteContainer.show();\r\n                }, function() {\r\n                    item.removeClass('active');\r\n                    editContainer.hide();\r\n                    deleteContainer.hide();\r\n                });\r\n\r\n                item.append(formContainer);\r\n                item.append(editContainer);\r\n                item.append(deleteContainer);\r\n                item.append(input);\r\n\r\n                var container = $('#Containerc26b256c_0696_4fc1_87ad_f4b03938c7aa');\r\n                container.append(item);\r\n                container.find('> input#Entity_Application_POS_Id').remove();\r\n                formContainer.html(data.html);\r\n                    var info = { id: data.info.id, uid: data.info.typeUid };\r\n                                                            posListChange();\r\n                $(\"#Entity_Application_POS\").val(currentIndex298efa41_21f9_48b0_8c84_469f9d058f2a > 0 ? currentIndex298efa41_21f9_48b0_8c84_469f9d058f2a : null);\r\n\r\n            } else if (data.error != undefined && data.error != null) {\r\n                jAlert(data.error, 'Ошибка');\r\n            }\r\n        }\r\n\r\n        closeWindow(data.info.popupId, true);\r\n        closeWindow(data.info.previosPopupId, true);\r\n    }\r\n\r\n    function editItem298efa41_21f9_48b0_8c84_469f9d058f2a(item) {\r\n        var input = $(item).find('> input:hidden');\r\n        var uid = input.attr('uid');\r\n        var id = input.val();\r\n        refreshPopupWithWidth(900, 'EditEntityPopup298efa41_21f9_48b0_8c84_469f9d058f2a', '/Common/Entity/EntityCollectionEditForm?ViewFormUid=11ab4a8c-cb09-44fd-9ec7-457a96cb3067&EditEntityCallback=editEntityCallback298efa41_21f9_48b0_8c84_469f9d058f2a(data)&EditFormId=editForm298efa41_21f9_48b0_8c84_469f9d058f2a&EditEntityPopup=EditEntityPopup298efa41_21f9_48b0_8c84_469f9d058f2a&ContainderId=Containerc26b256c_0696_4fc1_87ad_f4b03938c7aa&EditEntityFormContainerId=editEntityFormContainer298efa41_21f9_48b0_8c84_469f9d058f2a' + '&EntityUid=' + uid + '&EntityId=' + id);\r\n    }\r\n\r\n    function editEntityCallback298efa41_21f9_48b0_8c84_469f9d058f2a(data) {\r\n        if (data != undefined && data != null) {\r\n            if (data.html != undefined && data.html != null && data.info != undefined && data.info != null) {\r\n                var contai
            "text": ".notifications-popup,\r\n.notifications-popup * {\r\n    -moz-box-sizing: border-box;\r\n    -webkit-box-sizing: border-box;\r\n    box-sizing: border-box;\r\n}\r\n\r\n.notifications-popup {\r\n  font-size: 12px;\r\n  position: fixed;\r\n  top: calc(100% - 170px);\r\n  left: calc(100% - 120px);\r\n  z-index: 99999;\r\n}\r\n\r\n.notifications-popup .notifications-popup-top {\r\n    width: 100%;\r\n    display: flex;\r\n    -ms-flex-wrap: wrap;\r\n    -webkit-flex-wrap: wrap;\r\n    flex-wrap: wrap;\r\n    justify-content: flex-end;\r\n}\r\n\r\n.notifications-popup .notifications-popup-resizeble {\r\n  display: none;\r\n  width: 300px;\r\n  height: 200px;\r\n  min-width: 300px;\r\n  min-height: 200px;\r\n}\r\n\r\n.notifications-popup .notifications-popup-box {\r\n  background-color: #ffd4d4;\r\n  border: 2px solid #ff8686;\r\n  padding: 5px;\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n\r\n.notifications-popup .notifications-popup-box .notifications-popup-box-text {\r\n  overflow: auto;\r\n  max-height: 100%;\r\n}\r\n\r\n/*==========\r\nMAIN BUTTON\r\n==========*/\r\n\r\n.notifications-popup .notifications-popup-button {\r\n  background-color: #ffd4d4;\r\n  border: 5px solid #ff8686;\r\n  padding: 5px;\r\n  width: 120px;\r\n  text-align: center;\r\n  cursor: pointer;\r\n  font-size: 11px;\r\n}\r\n\r\n.notifications-popup .notifications-popup-button:hover {\r\n  background-color: #ffc4c4;\r\n  border-color: #fe6a6a;\r\n}\r\n\r\n.notifications-popup .notifications-popup-button svg {\r\n  width: 100px;\r\n  height: 50px;\r\n  font-size: 40px;\r\n  line-height: 50px;\r\n  margin-bottom: 5px;\r\n  color: #ff8686;\r\n  display: block;\r\n  content: \"\";\r\n}\r\n\r\n.notifications-popup .notifications-popup-button:hover svg {\r\n  color: #fe6a6a;\r\n}\r\n\r\n/*==========\r\nCLOSE BUTTON\r\n==========*/\r\n\r\n.notifications-popup .notifications-popup-close-button {\r\n  background-color: #ffd4d4;\r\n  border: 2px solid #ff8686;\r\n  border-bottom: none;\r\n  padding: 0;\r\n  width: 24px;\r\n  text-align: center;\r\n  cursor: pointer;\r\n  display: none;\r\n  color: #ff8686;\r\n}\r\n\r\n.notifications-popup .notifications-popup-close-button:hover {\r\n  background-color: #ffc4c4;\r\n  border-color: #fe6a6a;\r\n  color: #fe6a6a;\r\n}\r\n\r\n.notifications-popup .notifications-popup-close-button svg {\r\n  width: 20px;\r\n  height: 20px;\r\n  font-size: 18px;\r\n  line-height: 20px;\r\n  display: block;\r\n  content: \"\";\r\n}\r\n\r\n/*==========\r\nMOVE BUTTON\r\n==========*/\r\n\r\n.notifications-popup .notifications-popup-move-button {\r\n  background-color: #e4e4e4;\r\n  border: 2px solid #bbbbbb;\r\n  border-bottom: none;\r\n  padding: 0;\r\n  width: 24px;\r\n  text-align: center;\r\n  cursor: move;\r\n  color: #8e8e8e;\r\n  display: block;\r\n}\r\n\r\n\r\n.notifications-popup.opened .notifications-popup-move-button {\r\n  margin-left: 252px;\r\n}\r\n\r\n.notifications-popup .notifications-popup-move-button:hover {\r\n  background-color: #dddddd;\r\n  border-color: #8e8e8e;\r\n  color: #8e8e8e;\r\n}\r\n\r\n.notifications-popup .notifications-popup-move-button svg {\r\n  width: 20px;\r\n  height: 20px;\r\n  font-size: 18px;\r\n  line-height: 20px;\r\n  display: block;\r\n  content: \"\";\r\n}\r\n"

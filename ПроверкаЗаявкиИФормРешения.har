            "text": "$(document).ready(function(){\r\n     if (!jQuery.telerik) jQuery.telerik = { };\r\n     jQuery.telerik.cultureInfo = {\"shortDate\":\"dd.MM.yyyy\",\"longDate\":\"d MMMM yyyy \\u0027г.\\u0027\",\"longTime\":\"H:mm:ss\",\"shortTime\":\"H:mm\",\"fullDateTime\":\"d MMMM yyyy \\u0027г.\\u0027 H:mm:ss\",\"sortableDateTime\":\"yyyy\\u0027-\\u0027MM\\u0027-\\u0027dd\\u0027T\\u0027HH\\u0027:\\u0027mm\\u0027:\\u0027ss\",\"universalSortableDateTime\":\"yyyy\\u0027-\\u0027MM\\u0027-\\u0027dd HH\\u0027:\\u0027mm\\u0027:\\u0027ss\\u0027Z\\u0027\",\"generalDateShortTime\":\"dd.MM.yyyy H:mm\",\"generalDateTime\":\"dd.MM.yyyy H:mm:ss\",\"monthDay\":\"d MMMM\",\"monthYear\":\"MMMM yyyy\",\"days\":[\"воскресенье\",\"понедельник\",\"вторник\",\"среда\",\"четверг\",\"пятница\",\"суббота\"],\"abbrDays\":[\"Вс\",\"Пн\",\"Вт\",\"Ср\",\"Чт\",\"Пт\",\"Сб\"],\"abbrMonths\":[\"янв\",\"фев\",\"мар\",\"апр\",\"май\",\"июн\",\"июл\",\"авг\",\"сен\",\"окт\",\"ноя\",\"дек\",\"\"],\"months\":[\"Январь\",\"Февраль\",\"Март\",\"Апрель\",\"Май\",\"Июнь\",\"Июль\",\"Август\",\"Сентябрь\",\"Октябрь\",\"Ноябрь\",\"Декабрь\",\"\"],\"am\":\"\",\"pm\":\"\",\"dateSeparator\":\".\",\"timeSeparator\":\":\",\"firstDayOfWeek\":1,\"currencydecimaldigits\":2,\"currencydecimalseparator\":\",\",\"currencygroupseparator\":\" \",\"currencygroupsize\":3,\"currencynegative\":8,\"currencypositive\":3,\"currencysymbol\":\"₽\",\"numericdecimaldigits\":2,\"numericdecimalseparator\":\",\",\"numericgroupseparator\":\" \",\"numericgroupsize\":3,\"numericnegative\":1,\"percentdecimaldigits\":2,\"percentdecimalseparator\":\",\",\"percentgroupseparator\":\" \",\"percentgroupsize\":3,\"percentnegative\":1,\"percentpositive\":1,\"percentsymbol\":\"%\",\"name\":\"ru-RU\",\"nativeName\":\"русский (Россия)\",\"englishName\":\"Russian (Russia)\",\"dateElementOrder\":\"dmy\",\"rfc1123\":\"ddd, dd MMM yyyy HH\\u0027:\\u0027mm\\u0027:\\u0027ss \\u0027GMT\\u0027\",\"twoDigitYearMax\":2029};\r\n     Date.reInit();\r\n})